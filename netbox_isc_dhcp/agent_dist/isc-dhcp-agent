#!/usr/bin/env bash
# isc-dhcp-agent - keeps the ISC DHCP configuration of this server in sync with the NetBox plugin netbox_isc_dhcp.
# Every <interval> (set in NetBox) it sends the sha256 of its files, gets the plan (changes only) and applies it:
# backup (cp to the backup dir) -> download + sha256 check -> install (dhcpd.conf last) -> test -> restart -> delete -> report.
# On a failed test or a dhcpd that does not start it restores the backup and reports it. Needs: bash, curl, sha256sum, flock.
AGENT_VERSION="1.12.2"
CONF_FILE="${ISC_AGENT_CONF:-/etc/isc-dhcp-agent.conf}"

# ---- defaults (override in /etc/isc-dhcp-agent.conf) ----
NETBOX_URL=""                                   # agent API address shown in CFG pluginu -> DHCP servery (/api/plugins/isc-dhcp/agent/)
NETBOX_TOKEN=""                                 # agent API key from CFG pluginu -> DHCP servery
STATE_DIR="/var/lib/isc-dhcp-agent"
DHCP_SERVICE="isc-dhcp-server"
DHCPD_BIN="dhcpd"
ALLOWED_TEST_CMDS=("dhcpd -t -cf /etc/dhcp/dhcpd.conf")
ALLOWED_RESTART_CMDS=("systemctl restart isc-dhcp-server")
RUNNING_CHECK=""                                # empty = service active AND dhcpd process (real state); pidof only without systemd
START_WAIT=5                                    # seconds after restart before checking dhcpd
KEEP_BACKUPS=10
APPARMOR_FIX=yes                                # AppArmor profile of dhcpd found -> allow it to read the base path
CURL_OPTS=()                                    # e.g. (--cacert /etc/ssl/netbox.pem)
LOCK_FILE="/run/isc-dhcp-agent.lock"
LOG_FILE="/var/log/isc-dhcp-agent.log"               # own log file (also syslog / journal)
LOG_MAX_KB=5120                                 # rotated to .1 when bigger
# shellcheck disable=SC1090
[ -r "$CONF_FILE" ] && . "$CONF_FILE"
umask 022  # files and dirs must be readable by dhcpd (it may run as its own user)

AUTH=()
[ -n "$NETBOX_TOKEN" ] && AUTH=(-H "Authorization: Token $NETBOX_TOKEN")

usage() {
  cat <<USAGE
isc-dhcp-agent $AGENT_VERSION
  (no option)          run as daemon (systemd service isc-dhcp-agent)
  --once               one contact with NetBox (apply the plan if any) and exit
  --setup              ask for the NetBox agent API address and key, save, restart the service
  --set-url <url>      save the NetBox agent API address
  --set-token <key>    save the agent API key
  --set <NAME> <value> save another setting (e.g. START_WAIT 10, LOG_FILE /var/log/x.log)
  --show               show the settings (key hidden)
  --version            print the version
USAGE
}

conf_set() {  # conf_set NAME value: replace or add NAME="value" in the config file
  local name="$1" val="$2"
  [[ "$name" =~ ^[A-Z_]+$ ]] || { echo "bad name: $name" >&2; exit 2; }
  touch "$CONF_FILE" && chmod 600 "$CONF_FILE" || { echo "cannot write $CONF_FILE (run as root)" >&2; exit 1; }
  case "$val" in *[\"\\\$\`\|\&]*) echo "value must not contain quotes, \\, \$, \`, | or &" >&2; exit 2 ;; esac
  if grep -q "^$name=" "$CONF_FILE"; then
    sed -i "s|^$name=.*|$name=\"$val\"|" "$CONF_FILE"
  else
    echo "$name=\"$val\"" >>"$CONF_FILE"
  fi
  echo "$name saved in $CONF_FILE"
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1 && systemctl is-enabled --quiet isc-dhcp-agent 2>/dev/null; then
    systemctl restart isc-dhcp-agent && echo "service isc-dhcp-agent restarted"
  fi
}

show() {
  echo "config:   $CONF_FILE"
  echo "version:  $AGENT_VERSION"
  echo "url:      ${NETBOX_URL:-<not set>}"
  if [ -n "$NETBOX_TOKEN" ]; then echo "key:      ****${NETBOX_TOKEN: -4}"; else echo "key:      <not set>"; fi
  echo "log:      ${LOG_FILE:-<journal only>}"
  echo "state:    $STATE_DIR (running CFG: $(cat "$STATE_DIR/label" 2>/dev/null || echo -))"
  echo "service:  $(systemctl is-active isc-dhcp-agent 2>/dev/null || echo unknown)"
}

ONCE=0
case "${1:-}" in
  --version) echo "$AGENT_VERSION"; exit 0 ;;
  --help|-h) usage; exit 0 ;;
  --show) show; exit 0 ;;
  --set-url) [ -n "${2:-}" ] || { usage; exit 2; }; conf_set NETBOX_URL "$2"; restart_service; exit 0 ;;
  --set-token) [ -n "${2:-}" ] || { usage; exit 2; }; conf_set NETBOX_TOKEN "$2"; restart_service; exit 0 ;;
  --set) [ -n "${2:-}" ] && [ $# -ge 3 ] || { usage; exit 2; }; conf_set "$2" "$3"; restart_service; exit 0 ;;
  --setup)
    echo "NetBox agent API address (CFG pluginu -> DHCP servery -> API adresa agenta)"
    def="$NETBOX_URL"
    case "$def" in */plugins/isc-dhcp/dhcp/export/agent/) def="${def%/plugins/isc-dhcp/dhcp/export/agent/}/api/plugins/isc-dhcp/agent/" ;; esac
    read -r -p "URL [$def]: " u; u="${u:-$def}"
    [ -n "$u" ] || { echo "URL is required" >&2; exit 2; }
    echo "Agent API key (CFG pluginu -> DHCP servery -> API kľúč agenta); Enter = keep the current one"
    read -r -p "key: " k
    conf_set NETBOX_URL "$u"
    [ -n "$k" ] && conf_set NETBOX_TOKEN "$k"
    restart_service
    exit 0 ;;
  --once) ONCE=1 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac
log() {
  local line; line="$(date '+%F %T') $*"
  logger -t isc-dhcp-agent -- "$*" 2>/dev/null
  if [ -n "$LOG_FILE" ]; then
    if [ -f "$LOG_FILE" ] && [ "$(du -k "$LOG_FILE" 2>/dev/null | cut -f1)" -gt "${LOG_MAX_KB:-5120}" ]; then mv -f "$LOG_FILE" "$LOG_FILE.1"; fi
    echo "$line" >>"$LOG_FILE" 2>/dev/null
  fi
  [ -t 2 ] && echo "$line" >&2
}
die() { log "ERROR: $*"; exit 1; }

[ -n "$NETBOX_URL" ] || die "NETBOX_URL is not set in $CONF_FILE"
for c in curl sha256sum flock; do command -v "$c" >/dev/null 2>&1 || die "missing command: $c"; done
mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
exec 9>"$LOCK_FILE" || die "cannot open $LOCK_FILE"
flock -n 9 || die "another isc-dhcp-agent is running"

isc_version() {
  command -v "$DHCPD_BIN" >/dev/null 2>&1 || { echo none; return; }
  local v
  v=$("$DHCPD_BIN" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9]+)?' | head -1)
  echo "${v:-unknown}"
}

dhcpd4_pids() {  # PIDs of IPv4 dhcpd processes (a dhcpd -6 is not ours)
  local p
  for p in $(pidof dhcpd 2>/dev/null); do
    tr '\0' ' ' </proc/"$p"/cmdline 2>/dev/null | grep -qE '(^| )-6( |$)' || echo "$p"
  done
}

dhcpd_running() {  # REAL state: an IPv4 dhcpd process exists (it serves DHCP). The service state is reported separately (svc_state).
  if [ -n "$RUNNING_CHECK" ]; then bash -c "$RUNNING_CHECK" >/dev/null 2>&1 && echo 1 || echo 0; return; fi
  [ -n "$(dhcpd4_pids)" ] && echo 1 || echo 0
}

svc_state() {  # active | failed | inactive | activating | ... (none = no systemd)
  command -v systemctl >/dev/null 2>&1 || { echo none; return; }
  local st; st=$(systemctl is-active "$DHCP_SERVICE" 2>/dev/null | head -1); echo "${st:-unknown}"
}

svc_is_active() { [ "$(svc_state)" = active ] || { [ "$(svc_state)" = none ] && [ "$(dhcpd_running)" = 1 ]; }; }

svc_why() {  # short reason from the unit journal why the service is not active ("" when active)
  case "$(svc_state)" in active|none) return 0 ;; esac
  command -v journalctl >/dev/null 2>&1 || return 0
  local j l v6="" ifc hint=""
  j=$(journalctl -u "$DHCP_SERVICE" -n 80 --no-pager -q 2>/dev/null)
  echo "$j" | grep -qE 'DHCPv6 server.*failed|subnet6' && v6=1
  l=$(echo "$j" | grep -iE 'No subnet6? declaration|Address already in use|Not configured|Can.t |no such file|permission denied' | grep -v 'systemd\[' | head -1)
  [ -z "$l" ] && l=$(echo "$j" | grep -iE 'failed!' | tail -1)
  [ -z "$l" ] && l=$(echo "$j" | grep -iE 'fail' | tail -1)
  l=$(echo "$l" | sed -E 's/^.{15} [^ ]+ //; s/^[^ ]+\[[0-9]+\]: //' | cut -c1-140)
  if [ -n "$v6" ]; then
    l="IPv6 server (dhcpd6) fails: $l"
    ifc=$(echo "$j" | grep -oE 'No subnet6 declaration for [^ ]+' | head -1 | awk '{print $NF}')
    [ -f /etc/init.d/"$DHCP_SERVICE" ] && [ ! -f /etc/default/"$DHCP_SERVICE" ] && \
      hint=" | /etc/default/$DHCP_SERVICE is missing: the service starts IPv4 AND IPv6 - set INTERFACESv4=\"${ifc:-<interface>}\" INTERFACESv6=\"\""
  fi
  echo "$l$hint" | cut -c1-290
}

dedupe_dhcpd() {  # two or more IPv4 dhcpd at once (e.g. two restarts at the same moment) answer clients twice: keep one
  local pids keep pf p n; pids=$(dhcpd4_pids); n=$(echo "$pids" | grep -c .)
  [ "$n" -gt 1 ] || return 0
  for pf in $(dhcpd_pidfiles); do p=$(cat "$pf" 2>/dev/null); echo "$pids" | grep -qx "$p" && { keep=$p; break; }; done
  [ -z "$keep" ] && keep=$(for p in $pids; do echo "$(stat -c %Y /proc/"$p" 2>/dev/null) $p"; done | sort -n | tail -1 | awk '{print $2}')
  log "$n dhcpd processes run at once ($(echo $pids)) - keeping $keep (pidfile/newest), ending the others"
  for p in $pids; do [ "$p" = "$keep" ] || kill "$p" 2>/dev/null; done; sleep 2
  for p in $pids; do [ "$p" = "$keep" ] || { kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null; }; done
  log "dhcpd PID: $(echo $pids) -> $(echo $(dhcpd4_pids))  (duplicate ended)"
  DUP_FIXED="$n dhcpd processes ran at once ($(echo $pids)), kept $keep"
}

diag() {  # full check when something is not OK: last NetBox command, service, every dhcpd process, pidfile, service error
  local out="${1:-/dev/null}" p pf seen="" w
  {
    echo "CHECK last NetBox command: $(state last_cmd || true)"
    echo "CHECK service $DHCP_SERVICE: $(svc_state)"
    for p in $(pidof dhcpd 2>/dev/null); do
      echo "CHECK dhcpd pid $p: $(tr '\0' ' ' </proc/"$p"/cmdline 2>/dev/null | cut -c1-120)$(grep -q "$DHCP_SERVICE" /proc/"$p"/cgroup 2>/dev/null && echo ' (in the service)' || echo ' (OUTSIDE the service)')"
    done
    [ -z "$(pidof dhcpd 2>/dev/null)" ] && echo "CHECK dhcpd process: none"
    for pf in $(dhcpd_pidfiles); do
      pf=$(readlink -f "$pf" 2>/dev/null || echo "$pf"); case " $seen " in *" $pf "*) continue ;; esac; seen="$seen $pf"
      [ -f "$pf" ] && { p=$(cat "$pf" 2>/dev/null); echo "CHECK pidfile $pf: ${p:-empty} $(kill -0 "$p" 2>/dev/null && echo alive || echo DEAD)"; }
    done
    [ "$(dhcpd4_pids | grep -c .)" -gt 1 ] && echo "CHECK WARNING: $(dhcpd4_pids | grep -c .) IPv4 dhcpd processes at once"
    w=$(svc_why); [ -n "$w" ] && echo "CHECK service error: $w"
  } | tee -a "$out" | while IFS= read -r l; do log "$l"; done
}

state() { cat "$STATE_DIR/$1" 2>/dev/null; }

pid_now() { dhcpd4_pids | head -1; }  # first IPv4 dhcpd PID, empty = none

pid_step() {  # pid_step <label> <old-pid>: log "dhcpd PID <old> -> <now> (<label>)" to the log and the report
  local new l; dedupe_dhcpd; new=$(pid_now)
  l="dhcpd PID: ${2:-none} -> ${new:-none}  ($1)"
  echo "$l" >>"${OUT:-/dev/null}"; log "$l"
}

# a path the agent may write / delete: below the base path or the dhcpd.conf in the conf dir, no ".."
safe_path() {
  local p="$1"
  case "$p" in *..*|*" "*|"") return 1 ;; esac
  [ -n "${BASE:-}" ] && case "$p" in "$BASE"/*) return 0 ;; esac
  [ -n "${CONF_DIR:-}" ] && [ "$(dirname "$p")" = "$CONF_DIR" ] && return 0
  return 1
}

allowed() {  # allowed <cmd from NetBox> <local list...> -> the command to run (NetBox one only if allowed locally)
  local want="$1"; shift
  local c
  for c in "$@"; do [ "$c" = "$want" ] && { echo "$c"; return 0; }; done
  echo "$1"; return 1
}

report() {  # report <result> <output file>
  local url="$REPORT_URL" res="$1" out="$2"
  [ -n "$url" ] || return 0
  curl -sS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 60 -o /dev/null -X POST "$url" \
    --data-urlencode "result=$res" --data-urlencode "hash=$HASH" --data-urlencode "running=$(state running)" \
    --data-urlencode "kept=${KEPT:-}" --data-urlencode "pid=$(pid_now)" --data-urlencode "output@$out" || log "report failed (network)"
}

step() {  # step <code> <n> <text>: one line in the log + a STEP line in the report (NetBox Audit shows the whole flow)
  echo "STEP $1 $2" >>"$OUT"; log "$3"
}

restore() {  # copy the backup back, remove files that did not exist before
  local f n
  for f in "${NEW_FILES[@]}"; do rm -f -- "$f"; done
  n=$( [ -d "$BK" ] && find "$BK" -type f | wc -l || echo 0)
  [ -d "$BK" ] && cp -a "$BK/." / 2>>"$OUT"
  step restore "$n" "restored $n file(s) from the backup $BK, removed ${#NEW_FILES[@]} new file(s)"
}

apparmor_fix() {  # dhcpd confined by AppArmor cannot read <base path>: allow it (only when the kernel uses AppArmor for dhcpd)
  [ "$APPARMOR_FIX" = yes ] && [ -n "${BASE:-}" ] || return 0
  local prof=/etc/apparmor.d/usr.sbin.dhcpd loc=/etc/apparmor.d/local/usr.sbin.dhcpd rule="$BASE/** r,"
  local sec=/sys/kernel/security/apparmor loaded=0
  [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ] || return 0
  grep -q '^/usr/sbin/dhcpd ' "$sec/profiles" 2>/dev/null && loaded=1
  # 1) local rule (used whenever the profile is loaded again, e.g. after a reboot)
  if [ -f "$prof" ] && ! grep -qxF "  $rule" "$loc" 2>/dev/null; then
    mkdir -p "$(dirname "$loc")"
    { echo "  # added by isc-dhcp-agent: dhcpd reads the CFG files from NetBox"; echo "  $BASE/ r,"; echo "  $rule"; } >>"$loc"
    log "AppArmor: rule '$rule' added to $loc"; echo "AppArmor: rule '$rule' added to $loc" >>"$OUT"
    if command -v apparmor_parser >/dev/null 2>&1 && apparmor_parser -r "$prof" 2>>"$OUT"; then
      log "AppArmor: dhcpd profile reloaded with the rule"; AA_RELOADED=1; return 0
    fi
  fi
  # rule exists, tools exist, profile loaded but not reloaded by us since the agent started (e.g. AppArmor just came back): reload once
  if [ "$loaded" = 1 ] && [ -z "${AA_RELOADED:-}" ] && [ -f "$prof" ] && command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r "$prof" 2>>"$OUT" && log "AppArmor: dhcpd profile reloaded with the rule"
    AA_RELOADED=1; return 0
  fi
  # 2) no apparmor_parser (AppArmor tools removed) but the kernel still enforces the old profile: unload it
  if [ "$loaded" = 1 ] && ! command -v apparmor_parser >/dev/null 2>&1; then
    if printf '%s' /usr/sbin/dhcpd >"$sec/.remove" 2>>"$OUT"; then
      log "AppArmor: dhcpd profile unloaded from the kernel (no apparmor_parser to reload it with the rule)"
      echo "AppArmor: dhcpd profile unloaded from the kernel" >>"$OUT"
    else
      log "AppArmor: cannot unload the dhcpd profile - dhcpd cannot read $BASE"
    fi
  fi
}

apply() {
  rm -f "$STATE_DIR/want_up"  # a new CFG supersedes a pending "keep up" retry
  local i tmp rc cmd now prev
  OUT="$WORK/output"; : >"$OUT"
  # 1. download everything to a staging dir and check sha256 (nothing is changed when a file is bad)
  #    fast way: all files in ONE tar.gz; if that fails, file by file
  local bundled=0
  if [ -n "$BUNDLE" ] && command -v tar >/dev/null 2>&1; then
    printf '%s\n' "${DL_PATH[@]}" >"$WORK/paths"
    local t0=$SECONDS
    mkdir -p "$WORK/b"
    if curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 300 -X POST "$BUNDLE" --data-urlencode "paths@$WORK/paths" -o "$WORK/b.tgz" 2>>"$OUT" \
       && tar -m -xzf "$WORK/b.tgz" -C "$WORK/b" 2>>"$OUT"; then
      bundled=1
      log "downloaded bundle (tar.gz): $(du -k "$WORK/b.tgz" | cut -f1) KB in $((SECONDS - t0)) s"
      for i in "${!DL_PATH[@]}"; do
        safe_path "${DL_PATH[$i]}" || { echo "refused path ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
        if [ -f "$WORK/b${DL_PATH[$i]}" ] && [ "$(sha256sum "$WORK/b${DL_PATH[$i]}" | cut -d' ' -f1)" = "${DL_SHA[$i]}" ]; then
          mv "$WORK/b${DL_PATH[$i]}" "$WORK/f$i"
        else
          bundled=0; echo "bundle: missing or bad ${DL_PATH[$i]} - downloading file by file" >>"$OUT"; log "bundle: missing or bad ${DL_PATH[$i]} - downloading file by file"; break
        fi
      done
    else
      echo "bundle download failed - downloading file by file" >>"$OUT"; log "bundle download failed - downloading file by file"
    fi
  elif [ -n "$BUNDLE" ]; then
    log "tar not found - downloading file by file"
  fi
  [ "$bundled" = 1 ] && log "sha256 OK for all ${#DL_PATH[@]} files"
  [ "$bundled" = 1 ] || log "downloading ${#DL_PATH[@]} files one by one"
  [ "$bundled" = 1 ] || for i in "${!DL_PATH[@]}"; do
    safe_path "${DL_PATH[$i]}" || { echo "refused path ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
    curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 120 -o "$WORK/f$i" "${DL_URL[$i]}" 2>>"$OUT" \
      || { echo "download failed: ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
    [ "$(sha256sum "$WORK/f$i" | cut -d' ' -f1)" = "${DL_SHA[$i]}" ] \
      || { echo "sha256 mismatch: ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
  done
  step download "${#DL_PATH[@]}" "downloaded ${#DL_PATH[@]} file(s), sha256 OK"
  # 2. backup = cp of ONLY the files that will be replaced (a restore puts back exactly these)
  prev=$(state label); now=$(date +%Y%m%d-%H%M%S)
  BK="$BACKUP_TO/${prev:-start}_$now"
  mkdir -p "$BK" || { echo "cannot create backup $BK" >>"$OUT"; report failed "$OUT"; return; }
  local nb=0
  for i in "${DL_PATH[@]}"; do [ -e "$i" ] && cp -a --parents "$i" "$BK/" 2>>"$OUT" && nb=$((nb + 1)); done
  echo "backup: $BK" >>"$OUT"
  step backup "$nb" "backup: $nb file(s) that will be replaced -> $BK"
  # 3. install (order from NetBox: included files first, dhcpd.conf last)
  NEW_FILES=()
  for i in "${!DL_PATH[@]}"; do
    tmp="${DL_PATH[$i]}"
    [ -e "$tmp" ] || NEW_FILES+=("$tmp")
    mkdir -p -m 755 "$(dirname "$tmp")" && chmod 755 "$(dirname "$tmp")" && install -m 644 "$WORK/f$i" "$tmp.isc-new" && mv -f "$tmp.isc-new" "$tmp" \
      || { echo "install failed: $tmp" >>"$OUT"; restore; report failed "$OUT"; return; }
  done
  step install "${#DL_PATH[@]}" "applied ${#DL_PATH[@]} file(s) (dhcpd.conf last)"
  # 4. test (AppArmor rule first, if the system uses AppArmor for dhcpd)
  apparmor_fix
  cmd=$(allowed "$TEST_CMD" "${ALLOWED_TEST_CMDS[@]}") || echo "test command from NetBox not allowed locally, used: $cmd" >>"$OUT"
  echo "\$ $cmd" >>"$OUT"
  bash -c "$cmd" >>"$OUT" 2>&1; rc=$?
  if [ $rc -ne 0 ]; then
    step test fail "test FAILED (rc=$rc) - dhcpd -t says:"
    grep -v '^\$ \|^backup: \|^Internet Systems\|^Copyright\|^All rights\|^For info\|^$' "$OUT" | tail -n 25 | while IFS= read -r l; do log "  $l"; done
    if [ "$ON_FAIL" = keep ] || [ -z "$(state running)" ]; then  # debugging switch, or the FIRST CFG (nothing to go back to): keep it, never restart
      echo "KEPT: the new CFG stays on disk (debugging), dhcpd was not restarted" >>"$OUT"
      step kept 0 "new CFG kept on disk (first CFG or NetBox switch) - dhcpd NOT restarted"
      KEPT=1; report test_failed "$OUT"; KEPT=""; return
    fi
    restore; report test_failed "$OUT"; return
  fi
  step test ok "test OK (dhcpd -t)"
  # 5. restart + check that dhcpd runs
  cmd=$(allowed "$RESTART_CMD" "${ALLOWED_RESTART_CMDS[@]}") || echo "restart command from NetBox not allowed locally, used: $cmd" >>"$OUT"
  echo "\$ $cmd" >>"$OUT"
  mark_agent; rm -f "$STATE_DIR/admin_stopped"
  step restart 0 "restarting dhcpd"
  local p0; p0=$(pid_now); kill_stray "$OUT"; bash -c "$cmd" >>"$OUT" 2>&1
  sleep "$START_WAIT"; pid_step "restart" "$p0"
  if [ "$(dhcpd_running)" != 1 ]; then
    step notrunning 0 "dhcpd did NOT start - restoring"; restore
    kill_stray "$OUT"; bash -c "$cmd" >>"$OUT" 2>&1; sleep "$START_WAIT"
    echo "dhcpd after restore: $( [ "$(dhcpd_running)" = 1 ] && echo running || echo NOT running )" >>"$OUT"
    report rolled_back "$OUT"; return
  fi
  step running 0 "dhcpd is running"
  # 6. delete files the plugin does not generate any more (only managed paths)
  local nd=0
  for i in "${DELETES[@]}"; do safe_path "$i" && rm -f -- "$i" && echo "deleted $i" >>"$OUT" && nd=$((nd + 1)); done
  [ "$nd" -gt 0 ] && step delete "$nd" "deleted $nd file(s) the plugin no longer generates"
  # 7. remember + report
  echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"
  log "CFG $CFG applied (${#DL_PATH[@]} files, ${#DELETES[@]} deleted, dhcpd pid $(pid_now))"
  rm -f "$STATE_DIR/want_up"; report ok "$OUT"
  # keep the newest backups only
  ls -1dt "$BACKUP_TO"/*/ 2>/dev/null | tail -n +"$((KEEP_BACKUPS + 1))" | while read -r d; do rm -rf -- "$d"; done
}

other_scheme() {  # https://x -> http://x and back
  case "$1" in https://*) echo "http://${1#https://}" ;; http://*) echo "https://${1#http://}" ;; *) echo "$1" ;; esac
}

save_url() {  # remember the working URL in the config file
  [ -w "$CONF_FILE" ] && sed -i "s|^NETBOX_URL=.*|NETBOX_URL=\"$1\"|" "$CONF_FILE" && log "NETBOX_URL changed to $1 (saved in $CONF_FILE)"
}

svc() {  # svc <start|stop|restart>: the DHCP service, without any command from NetBox
  if command -v systemctl >/dev/null 2>&1; then systemctl "$1" "$DHCP_SERVICE"; else service "$DHCP_SERVICE" "$1"; fi
}

dhcpd_pidfiles() {  # pidfile from a running dhcpd (-pf arg), plus the Debian defaults
  local pid pf
  for pid in $(pidof dhcpd 2>/dev/null); do
    pf=$(tr '\0' ' ' </proc/"$pid"/cmdline 2>/dev/null | grep -oE '(^| )-pf +[^ ]+' | awk '{print $NF}')
    [ -n "$pf" ] && echo "$pf"
  done
  echo /run/dhcpd.pid; echo /var/run/dhcpd.pid
}

clean_stale_pidfile() {  # a pidfile left by a crashed / killed dhcpd points to a dead pid and blocks a clean start (start-stop-daemon)
  local out="$1"; shift; local pf p seen=""
  for pf in "$@"; do
    case " $seen " in *" $pf "*) continue ;; esac; seen="$seen $pf"
    [ -f "$pf" ] || continue
    p=$(cat "$pf" 2>/dev/null)
    if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then
      rm -f "$pf" && { echo "removed stale pidfile $pf (pid ${p:-empty} dead)" >>"$out"; log "removed stale pidfile $pf (pid ${p:-empty} dead)"; }
    fi
  done
}

kill_stray() {  # dhcpd processes while the service is not active (started by hand / left by a failed start): end them + clear a stale pidfile; both block a clean start
  svc_is_active && [ "$(dhcpd_running)" = 1 ] && return 0  # healthy service with its dhcpd: never touch it
  local out="${1:-/dev/null}" pfs; pfs=$(dhcpd_pidfiles)  # read -pf while a process may still be alive
  if [ -z "$(dhcpd4_pids)" ]; then
    command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$DHCP_SERVICE" 2>/dev/null && systemctl stop "$DHCP_SERVICE" >/dev/null 2>&1  # crashed: service "active" without a process
    clean_stale_pidfile "$out" $pfs; return 0
  fi
  local p0; p0=$(pid_now)
  echo "dhcpd process without a working service (pid $p0, service $(svc_state)) - ending it for a clean start" >>"$out"
  log "dhcpd process without a working service (pid $p0, service $(svc_state)) - ending it for a clean start"
  kill $(dhcpd4_pids) 2>/dev/null; local i=0
  while [ $i -lt 5 ] && [ -n "$(dhcpd4_pids)" ]; do sleep 1; i=$((i+1)); done
  [ -n "$(dhcpd4_pids)" ] && kill -9 $(dhcpd4_pids) 2>/dev/null; sleep 1
  command -v systemctl >/dev/null 2>&1 && systemctl reset-failed "$DHCP_SERVICE" 2>/dev/null
  clean_stale_pidfile "$out" $pfs; pid_step "kill stray" "$p0"; return 0
}

wait_down() { local i=0; while [ $i -lt "$1" ] && [ "$(dhcpd_running)" = 1 ]; do sleep 1; i=$((i+1)); done; }

mark_agent() { echo 1 >"$STATE_DIR/agent_did"; }  # dhcpd started/stopped by the agent (not by hand)

dhcpd_event() {  # agent_start | agent_stop | manual_start | manual_stop since the last contact NetBox accepted ("" = no change)
  local now prev who
  now=$(dhcpd_running); prev=$(state dhcpd_prev)
  EVENT_NOW="$now"
  [ -z "$prev" ] || [ "$now" = "$prev" ] && return 0
  who=manual; [ "$(state agent_did)" = 1 ] && who=agent
  [ "$now" = 1 ] && echo "${who}_start" || echo "${who}_stop"
}

why_changed() {  # $1 = start|stop: what the system logged since the last contact (sudo command, systemd unit, kernel crash)
  command -v journalctl >/dev/null 2>&1 || { echo "no journal - cannot tell"; return; }
  local since; since=$(state contact_ts); since="@${since:-$(( $(date +%s) - 600 ))}"
  local l
  if [ "$1" = stop ]; then
    l=$(journalctl -k --since "$since" --no-pager -q 2>/dev/null | grep -iE 'dhcpd.*(segfault|killed process|out of memory|general protection)|oom-kill.*dhcpd' | tail -1)
    [ -n "$l" ] && { echo "CRASH: $(echo "$l" | sed -E 's/^.{16}[^ ]+ kernel: //' | cut -c1-200)"; return; }
  fi
  l=$(journalctl --since "$since" --no-pager -q _COMM=sudo 2>/dev/null | grep -E 'COMMAND=.*(isc-dhcp-server|dhcpd)' | tail -1)
  [ -n "$l" ] && { echo "command (sudo): $(echo "$l" | sed -E 's/.*sudo\[[0-9]+\]: *([^ ]+) *:.*COMMAND=/\1: /' | cut -c1-200)"; return; }
  if [ "$1" = stop ]; then
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -E 'Stopping|Stopped|Deactivated' | tail -1)
    [ -n "$l" ] && { echo "command: systemctl/service stop (root)"; return; }
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -iE 'exit|fail|signal|killed' | tail -1)
    [ -n "$l" ] && { echo "crash/kill: $(echo "$l" | sed -E 's/^.{16}[^ ]+ //' | cut -c1-150)"; return; }
    l=$(journalctl --since "$since" --no-pager -q 2>/dev/null | grep -E 'dhcpd\[[0-9]+\]' | tail -1)
    [ -n "$l" ] && { echo "crash/kill (no stop command), last dhcpd log: $(echo "$l" | sed -E 's/^.{16}[^ ]+ //' | cut -c1-150)"; return; }
    echo "crash/kill (no stop command in the journal)"
  else
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -E 'Starting|Started' | tail -1)
    [ -n "$l" ] && { echo "command: systemctl/service start (root)"; return; }
    echo "dhcpd started directly (not through the service)"
  fi
}

event_sent() {  # NetBox accepted the contact: remember the state (an event is never lost on 503 / NetBox down)
  [ -n "${EVENT_NOW:-}" ] && echo "$EVENT_NOW" >"$STATE_DIR/dhcpd_prev"
  rm -f "$STATE_DIR/agent_did"
  date +%s >"$STATE_DIR/contact_ts"
  case "$EVENT" in
    manual_stop) log "dhcpd stopped outside the agent: $WHY - reported to NetBox" ;;
    manual_start) log "dhcpd started outside the agent: $WHY - reported to NetBox" ;;
  esac
}

run_cmd() {  # command from NetBox (start | stop | restart | update), once per id; result goes back with the next contact
  [ -n "$CMD" ] && [ -n "$CMD_ID" ] || return 0
  [ "$(state cmd_done | cut -d: -f1)" = "$CMD_ID" ] && return 0
  local res=ok txt="" out="$WORK/cmd" rc
  : >"$out"
  case "$CMD" in
    stop)
      echo 1 >"$STATE_DIR/admin_stopped"; rm -f "$STATE_DIR/want_up"; mark_agent
      svc stop >"$out" 2>&1 || true; wait_down 5
      txt="dhcpd stopped"
      if [ -n "$(dhcpd4_pids)" ]; then kill_stray "$out"; txt="dhcpd stopped (process left by the service ended)"; fi
      [ "$(dhcpd_running)" = 1 ] && { res=failed; txt="dhcpd still running: $(grep -v '^$' "$out" | tail -1)"; } ;;
    start|restart)
      rm -f "$STATE_DIR/admin_stopped"
      echo 1 >"$STATE_DIR/want_up"; date +%s >"$STATE_DIR/want_up_ts"  # keep dhcpd up: retry every ~minute until it runs
      local tcmd p0; tcmd="${TEST_CMD:-${ALLOWED_TEST_CMDS[0]}}"; tcmd=$(allowed "$tcmd" "${ALLOWED_TEST_CMDS[@]}")
      bash -c "$tcmd" >"$out" 2>&1; rc=$?
      if [ $rc -ne 0 ]; then
        rm -f "$STATE_DIR/want_up"  # bad CFG -> this IS a CFG problem, do not retry
        res=failed; txt="dhcpd -t failed: $(grep -i -m1 -E 'line [0-9]+|error|denied|can.t' "$out")"
      else
        OUT="$out"; p0=$(pid_now); kill_stray "$out"; mark_agent; svc "$CMD" >>"$out" 2>&1; sleep "$START_WAIT"; pid_step "$CMD" "$p0"; OUT=""
        if [ "$(dhcpd_running)" = 1 ]; then rm -f "$STATE_DIR/want_up"; txt="dhcpd running (pid $(pid_now))"
        else res=failed; txt="dhcpd did not start (CFG is OK) - retrying every minute"; fi
      fi ;;
    update)
      local self new="$WORK/agent.new"; self=$(readlink -f "$0")
      if [ -z "$AGENT_URL" ] || ! curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 120 -o "$new" "$AGENT_URL" 2>"$out"; then
        res=failed; txt="download failed"
      elif [ "$(sha256sum "$new" | cut -d' ' -f1)" != "$AGENT_SHA" ]; then
        res=failed; txt="sha256 mismatch"
      elif ! bash -n "$new" 2>>"$out"; then
        res=failed; txt="new agent has a syntax error"
      else
        txt="updated to $(grep -m1 '^AGENT_VERSION=' "$new" | cut -d'"' -f2)"
        echo "$CMD_ID:$res:$txt" >"$STATE_DIR/cmd_done"
        install -m 755 "$new" "$self" && log "agent $txt - restarting the agent"
        [ "$ONCE" = 1 ] || { command -v systemctl >/dev/null 2>&1 && systemctl --no-block restart isc-dhcp-agent; }
        return 0
      fi ;;
    *) res=failed; txt="unknown command $CMD" ;;
  esac
  echo "$CMD_ID:$res:$txt" >"$STATE_DIR/cmd_done"
  echo "$CMD $(date '+%F %T') $res" >"$STATE_DIR/last_cmd"
  log "NetBox command '$CMD': $res - $txt"
  [ "$res" = ok ] || [ "$CMD" = update ] || diag "$out"
}

ensure_up() {  # keep dhcpd up after Start/Restart: test CFG, kill a stray dhcpd, remove a stale pidfile, start; retry ~1/min until it runs (NOT a CFG error)
  [ -e "$STATE_DIR/want_up" ] || return 0
  [ "$(state admin_stopped)" = 1 ] && { rm -f "$STATE_DIR/want_up"; return 0; }
  if [ "$(dhcpd_running)" = 1 ] && [ ! -e "$STATE_DIR/force_restart" ]; then  # dhcpd serves (maybe started by hand / by the service): done, NetBox gets OK
    rm -f "$STATE_DIR/want_up"; OUT="$WORK/up"; : >"$OUT"
    echo "dhcpd is running (pid $(pid_now))" >>"$OUT"; echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"
    log "dhcpd is running (pid $(pid_now)) - retry finished"; report ok "$OUT"; return 0
  fi
  local now last; now=$(date +%s); last=$(state want_up_ts)
  [ -n "$last" ] && [ $((now - last)) -lt 55 ] && return 0  # at most once per minute
  echo "$now" >"$STATE_DIR/want_up_ts"; rm -f "$STATE_DIR/force_restart"
  OUT="$WORK/up"; : >"$OUT"
  local cmd rc p0
  cmd="${TEST_CMD:-${ALLOWED_TEST_CMDS[0]}}"; cmd=$(allowed "$cmd" "${ALLOWED_TEST_CMDS[@]}")
  echo "\$ $cmd" >>"$OUT"; bash -c "$cmd" >>"$OUT" 2>&1; rc=$?
  if [ $rc -ne 0 ]; then  # the on-disk CFG is bad -> this really is a CFG problem, stop retrying
    rm -f "$STATE_DIR/want_up"
    log "retry: dhcpd -t FAILED - this is a CFG problem, stopping retries"
    report test_failed "$OUT"; return 0
  fi
  log "retry: CFG tests OK, (re)starting dhcpd"
  p0=$(pid_now); kill_stray "$OUT"
  cmd="${RESTART_CMD:-${ALLOWED_RESTART_CMDS[0]}}"; cmd=$(allowed "$cmd" "${ALLOWED_RESTART_CMDS[@]}")
  echo "\$ $cmd" >>"$OUT"; mark_agent; bash -c "$cmd" >>"$OUT" 2>&1; sleep "$START_WAIT"; pid_step "retry start" "$p0"
  if [ "$(dhcpd_running)" = 1 ]; then
    rm -f "$STATE_DIR/want_up"; echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"
    log "dhcpd is UP (pid $(pid_now)) after retry"; report ok "$OUT"
  else
    log "dhcpd still not up (NOT a CFG problem) - will try again in ~1 min"
    diag "$OUT"; report start_failed "$OUT"
  fi
}

heal() {  # (a) manual restart asked in NetBox -> continuous retry; (b) disk = current CFG but dhcpd down -> one automatic attempt per CFG
  [ "$(isc_version)" != none ] || return 0
  [ "$(state admin_stopped)" = 1 ] && return 0  # stopped from NetBox: stays down until Start / Restart / a new CFG
  if [ -n "$RESTART_REQ" ] && [ "$RESTART_REQ" != "$(state restart_req)" ]; then
    echo "$RESTART_REQ" >"$STATE_DIR/restart_req"; log "manual restart asked in NetBox"
    echo 1 >"$STATE_DIR/want_up"; echo 1 >"$STATE_DIR/force_restart"; rm -f "$STATE_DIR/want_up_ts"; return 0  # ensure_up does a real restart, and keeps retrying
  fi
  [ -e "$STATE_DIR/want_up" ] && return 0  # continuous retry already armed (ensure_up handles it)
  # disk = current CFG but dhcpd is down (crash, failed service, after an agent update) -> arm continuous retry automatically
  if [ "$DISK" = current ] && [ "$(dhcpd_running)" != 1 ]; then
    echo 1 >"$STATE_DIR/want_up"; rm -f "$STATE_DIR/want_up_ts"
    log "dhcpd is down and the disk already has the current CFG - will keep (re)starting it until it is up"
  fi
}

contact() {
  local have="$WORK/have" resp="$WORK/resp" code f d
  : >"$have"
  f=$(state conf); [ -n "$f" ] && [ -f "$f" ] && sha256sum "$f" >>"$have"
  while read -r d; do [ -d "$d" ] && find "$d" -maxdepth 1 -type f ! -name '*.isc-new' -exec sha256sum {} + >>"$have"; done < <(state dirs)
  local url alt
  DUP_FIXED=""; dedupe_dhcpd
  EVENT=$(dhcpd_event); EVENT_NOW=$(dhcpd_running); WHY=""
  case "$EVENT" in manual_stop) WHY=$(why_changed stop) ;; manual_start) WHY=$(why_changed start) ;; esac
  for url in "$NETBOX_URL" "$(other_scheme "$NETBOX_URL")"; do  # try https and http, keep the one that works
    code=$(curl -sS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 60 -o "$resp" -w '%{http_code} %{redirect_url}' -X POST "${url}?format=text" \
      --data-urlencode "files@$have" --data-urlencode "agent=$AGENT_VERSION" --data-urlencode "isc=$(isc_version)" \
      --data-urlencode "dhcpd=$(dhcpd_running)" --data-urlencode "running=$(state running)" \
      --data-urlencode "dhcpd_event=$EVENT" --data-urlencode "dhcpd_why=$WHY" --data-urlencode "dhcpd_pid=$(pid_now)" --data-urlencode "svc=$(svc_state)" --data-urlencode "dup=$DUP_FIXED" --data-urlencode "svc_why=$(svc_why)" --data-urlencode "cmd_done=$(state cmd_done)" 2>"$WORK/curlerr") && break
    log "NetBox not reachable at $url: $(cat "$WORK/curlerr")"
    code=000
  done
  [ "$code" = 000 ] && return 1
  local redir="${code#* }"; code="${code%% *}"
  if [ "$url" != "$NETBOX_URL" ]; then NETBOX_URL="$url"; save_url "$url"; fi
  DL_PATH=(); DL_SHA=(); DL_URL=(); BACKUP_PATHS=(); DELETES=(); DIRS=()
  TEST_CMD=""; RESTART_CMD=""; REPORT_URL=""; BACKUP_TO=""; HASH=""; CFG=""; WAIT=""; ERR=""; CONF_DIR=""; BASE=""; NEWKEY=""; ON_FAIL="restore"; BUNDLE=""; DISK=""; RESTART_REQ=""; CMD=""; CMD_ID=""; AGENT_URL=""; AGENT_SHA=""
  local key a b c
  while IFS=$'\t' read -r key a b c; do
    case "$key" in
      interval) [[ "$a" =~ ^[0-9]+$ ]] && INTERVAL="$a" ;;
      key) NEWKEY="$a" ;;
      report) REPORT_URL="$a" ;;
      on_test_fail) ON_FAIL="$a" ;;
      bundle) BUNDLE="$a" ;;
      disk) DISK="$a" ;;
      restart_req) RESTART_REQ="$a" ;;
      cmd) CMD="$a"; CMD_ID="$b" ;;
      agent_url) AGENT_URL="$a" ;;
      agent_sha) AGENT_SHA="$a" ;;
      hash) HASH="$a" ;; cfg) CFG="$a" ;; wait) WAIT="$a" ;; error) ERR="$a" ;;
      conf_dir) CONF_DIR="$a" ;; base) BASE="$a" ;; dir) DIRS+=("$a") ;;
      backup) BACKUP_TO="$a"; IFS=$'\t' read -r -a BACKUP_PATHS <<<"$b${c:+	$c}" ;;
      download) DL_PATH+=("$a"); DL_SHA+=("$b"); DL_URL+=("$c") ;;
      test) TEST_CMD="$a" ;; restart) RESTART_CMD="$a" ;; delete) DELETES+=("$a") ;; report) REPORT_URL="$a" ;;
    esac
  done <"$resp"
  [ "$code" = 200 ] && event_sent
  if [ "$code" != 200 ]; then
    case "$code" in
      403) log "NetBox answered 403: this server's IP is not in CFG pluginu -> DHCP servery, the server is switched off, or NETBOX_TOKEN is missing/wrong (see Audit -> Agent)" ;;
      301|302|307|308) log "NetBox answered $code (redirect to $redir): login page = use the agent API address (/api/plugins/isc-dhcp/agent/) + NETBOX_TOKEN, https = use the https URL" ;;
      000) log "NetBox not reachable (DNS, firewall or TLS certificate - see CURL_OPTS)" ;;
      *) log "NetBox answered $code ${ERR}" ;;
    esac
    return 1
  fi
  if [ -n "$NEWKEY" ] && [ "$NEWKEY" != "$NETBOX_TOKEN" ]; then  # key change in NetBox: test the new key, then keep it
    local tc
    tc=$(curl -sS "${CURL_OPTS[@]}" -H "Authorization: Token $NEWKEY" --max-time 60 -o /dev/null -w '%{http_code}' "${NETBOX_URL}?format=text" 2>/dev/null)
    if [ "$tc" = 200 ]; then
      conf_set NETBOX_TOKEN "$NEWKEY" >/dev/null && NETBOX_TOKEN="$NEWKEY" && AUTH=(-H "Authorization: Token $NETBOX_TOKEN")
      log "new API key received from NetBox, tested OK and saved"
    else
      log "new API key from NetBox did not work (HTTP $tc) - keeping the old one"
    fi
  fi
  OUT="$WORK/aa"; apparmor_fix  # AppArmor is watched on every contact
  [ ${#DIRS[@]} -gt 0 ] && printf '%s\n' "${DIRS[@]}" >"$STATE_DIR/dirs"
  for f in "${DL_PATH[@]}"; do [ "$(dirname "$f")" = "$CONF_DIR" ] && echo "$f" >"$STATE_DIR/conf"; done
  [ -z "$(state conf)" ] && [ -n "$CONF_DIR" ] && echo "$CONF_DIR/dhcpd.conf" >"$STATE_DIR/conf"
  run_cmd  # Start / Stop / Restart / Update from NetBox
  heal  # manual restart / self-heal
  ensure_up  # keep retrying dhcpd start every ~minute after Start/Restart until it is up
  local dk; dk="$(dhcpd_running)|$(svc_state)|$(pid_now)"
  if [ "$dk" != "$(state diag_key)" ]; then
    echo "$dk" >"$STATE_DIR/diag_key"
    [ "$(isc_version)" != none ] && { [ "$(dhcpd_running)" != 1 ] || ! svc_is_active; } && diag "$WORK/diag"
  fi
  if [ -n "$WAIT" ]; then  # log only when the reason changes (no line every interval)
    [ "$WAIT $CFG" != "${LAST_WAIT:-}" ] && log "waiting ($WAIT) CFG $CFG"
    LAST_WAIT="$WAIT $CFG"; return 0
  fi
  LAST_WAIT=""
  if [ ${#DL_PATH[@]} -eq 0 ] && [ ${#DELETES[@]} -eq 0 ]; then return 0; fi
  [ "$(isc_version)" = none ] && { log "ISC dhcpd is not installed - plan ignored"; return 0; }
  log "CFG $CFG: ${#DL_PATH[@]} to download, ${#DELETES[@]} to delete"
  apply
}

INTERVAL=60
[ "$(state agent_ver)" = "$AGENT_VERSION" ] || { dhcpd_running >"$STATE_DIR/dhcpd_prev"; echo "$AGENT_VERSION" >"$STATE_DIR/agent_ver"; }
log "isc-dhcp-agent $AGENT_VERSION started, NetBox $NETBOX_URL, ISC $(isc_version), dhcpd $([ "$(dhcpd_running)" = 1 ] && echo "running (pid $(pid_now))" || echo NOT running), service $(svc_state)"
while true; do
  WORK=$(mktemp -d) || die "mktemp failed"
  contact
  rm -rf -- "$WORK"
  [ "$ONCE" = 1 ] && break
  sleep "$INTERVAL"
done
