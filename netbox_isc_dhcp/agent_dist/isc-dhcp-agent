#!/usr/bin/env bash
# isc-dhcp-agent - keeps the ISC DHCP configuration of this server in sync with the NetBox plugin netbox_isc_dhcp.
# Every <interval> (set in NetBox) it sends the sha256 of its files, gets the plan (changes only) and applies it:
# backup (cp to the backup dir) -> download + sha256 check -> install (dhcpd.conf last) -> test -> restart -> delete -> report.
# On a failed test or a dhcpd that does not start it restores the backup and reports it. Needs: bash, curl, sha256sum, flock.
AGENT_VERSION="1.27.0"
CONF_FILE="${ISC_AGENT_CONF:-/etc/isc-dhcp-agent.conf}"

# ---- defaults (override in /etc/isc-dhcp-agent.conf) ----
NETBOX_URL=""                                   # agent API address shown in CFG pluginu -> DHCP servery (/api/plugins/isc-dhcp/agent/)
NETBOX_TOKEN=""                                 # agent API key from CFG pluginu -> DHCP servery
STATE_DIR="/var/lib/isc-dhcp-agent"
DHCP_SERVICE="isc-dhcp-server"
DHCPD_BIN="dhcpd"
ALLOWED_TEST_CMDS=("dhcpd -t -cf /etc/dhcp/dhcpd.conf")
ALLOWED_RESTART_CMDS=("systemctl restart isc-dhcp-server")
RUNNING_CHECK=""                                # empty = service active AND dhcpd process (real state); pidof only without systemd
START_WAIT=5                                    # seconds after restart before checking dhcpd
KEEP_BACKUPS=10
TEST_SERVER=netbox                              # netbox = the switch "Test server" in NetBox decides; no = never simulate here; yes = always allowed
LEASES_FILE="/var/lib/dhcp/dhcpd.leases"        # lease database: copied into every backup (_leases/), never restored or deleted
APPARMOR_FIX=yes                                # AppArmor profile of dhcpd found -> allow it to read the base path
DEFAULT_FIX=yes                                 # /etc/default/isc-dhcp-server: IPv4 interfaces set, IPv6 server off (fixed when wrong)
CURL_OPTS=()                                    # e.g. (--cacert /etc/ssl/netbox.pem)
ALLOW_HTTP=yes                                  # no = never use plain http (key + CFG unencrypted); yes = http allowed as a fallback
DHCP_CONF_DIR="/etc/dhcp"                       # dhcpd.conf lives here - fixed on this server, NetBox cannot change it
ALLOWED_BASE=""                                 # base path of the CFG files this server accepts (empty = the first one NetBox sends is pinned here)
LOCK_FILE="/run/isc-dhcp-agent.lock"
LOG_FILE="/var/log/isc-dhcp-agent.log"               # own log file (also syslog / journal)
LOG_MAX_KB=5120                                 # rotated to .1 when bigger
# shellcheck disable=SC1090
[ -r "$CONF_FILE" ] && . "$CONF_FILE"
umask 022  # files and dirs must be readable by dhcpd (it may run as its own user)

# THE ONLY commands NetBox can send to this agent - 1:1 with the plugin (export/agent.py AGENT_COMMANDS, shown read-only
# in CFG pluginu -> DHCP servery). Set after the config file: it cannot be extended. A line from NetBox that is not here is
# ignored and logged as SECURITY. Test / restart run only what ALLOWED_TEST_CMDS / ALLOWED_RESTART_CMDS allow.
AGENT_COMMANDS=(download bundle backup test restart on_test_fail delete "cmd start" "cmd stop" "cmd restart" "cmd update" "cmd simfirst" "cmd restoreleases" "cmd delfirst" agent_url agent_sha key interval report base dir conf_dir hash cfg mode server wait wait_for error disk restart_req check leases time_format test_server)
BACKUP_DEFAULT="/opt/BCK"  # backups ONLY below /opt; rm -rf only there and only on the agent's own backup dirs <CFG>_<YYYYmmdd-HHMMSS>

is_command() { printf '%s\n' "${AGENT_COMMANDS[@]}" | grep -qxF -- "$1"; }

hdr_file() {  # hdr_file <file> <key>: the key goes to curl from a root-only file, never in the command line (ps shows it)
  ( umask 077; printf 'Authorization: Token %s\n' "$2" >"$1" ) 2>/dev/null
}
curl_hdr_file_ok() {  # curl -H @file needs curl 7.55+
  local v; v=$(curl --version 2>/dev/null | awk 'NR==1{print $2}'); [ -n "$v" ] || return 1
  [ "$(printf '%s\n7.55.0\n' "$v" | sort -V | head -1)" = 7.55.0 ]
}
set_auth() {
  AUTH=(); [ -n "$NETBOX_TOKEN" ] || return 0
  if [ "$(id -u)" = 0 ] && curl_hdr_file_ok && mkdir -p "$STATE_DIR" 2>/dev/null && hdr_file "$STATE_DIR/auth.hdr" "$NETBOX_TOKEN"; then
    AUTH=(-H "@$STATE_DIR/auth.hdr")
  else
    AUTH=(-H "Authorization: Token $NETBOX_TOKEN")
  fi
}
set_auth

usage() {
  cat <<USAGE
isc-dhcp-agent $AGENT_VERSION
  (no option)          run as daemon (systemd service isc-dhcp-agent)
  --once               one contact with NetBox (apply the plan if any) and exit
  --setup              ask for the NetBox agent API address and key, save, restart the service
  --set-url <url>      save the NetBox agent API address
  --set-token <key>    save the agent API key
  --set <NAME> <value> save another setting (e.g. START_WAIT 10, LOG_FILE /var/log/x.log)
  --show               show the settings (key hidden)
  --version            print the version
USAGE
}

conf_set() {  # conf_set NAME value: replace or add NAME="value" in the config file
  local name="$1" val="$2"
  [[ "$name" =~ ^[A-Z_]+$ ]] || { echo "bad name: $name" >&2; exit 2; }
  touch "$CONF_FILE" && chmod 600 "$CONF_FILE" || { echo "cannot write $CONF_FILE (run as root)" >&2; exit 1; }
  case "$val" in *[\"\\\$\`\|\&]*) echo "value must not contain quotes, \\, \$, \`, | or &" >&2; exit 2 ;; esac
  if grep -q "^$name=" "$CONF_FILE"; then
    sed -i "s|^$name=.*|$name=\"$val\"|" "$CONF_FILE"
  else
    echo "$name=\"$val\"" >>"$CONF_FILE"
  fi
  echo "$name saved in $CONF_FILE"
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1 && systemctl is-enabled --quiet isc-dhcp-agent 2>/dev/null; then
    systemctl restart isc-dhcp-agent && echo "service isc-dhcp-agent restarted"
  fi
}

show() {
  echo "config:   $CONF_FILE"
  echo "version:  $AGENT_VERSION"
  echo "url:      ${NETBOX_URL:-<not set>}"
  if [ -n "$NETBOX_TOKEN" ]; then echo "key:      ****${NETBOX_TOKEN: -4}"; else echo "key:      <not set>"; fi
  echo "log:      ${LOG_FILE:-<journal only>}"
  echo "state:    $STATE_DIR (running CFG: $(cat "$STATE_DIR/label" 2>/dev/null || echo -))"
  echo "service:  $(systemctl is-active isc-dhcp-agent 2>/dev/null || echo unknown)"
}

ONCE=0
case "${1:-}" in
  --version) echo "$AGENT_VERSION"; exit 0 ;;
  --help|-h) usage; exit 0 ;;
  --show) show; exit 0 ;;
  --set-url) [ -n "${2:-}" ] || { usage; exit 2; }; conf_set NETBOX_URL "$2"; restart_service; exit 0 ;;
  --set-token) [ -n "${2:-}" ] || { usage; exit 2; }; conf_set NETBOX_TOKEN "$2"; restart_service; exit 0 ;;
  --set) [ -n "${2:-}" ] && [ $# -ge 3 ] || { usage; exit 2; }; conf_set "$2" "$3"; restart_service; exit 0 ;;
  --setup)
    echo "NetBox agent API address (CFG pluginu -> DHCP servery -> API adresa agenta)"
    def="$NETBOX_URL"
    case "$def" in */plugins/isc-dhcp/dhcp/export/agent/) def="${def%/plugins/isc-dhcp/dhcp/export/agent/}/api/plugins/isc-dhcp/agent/" ;; esac
    read -r -p "URL [$def]: " u; u="${u:-$def}"
    [ -n "$u" ] || { echo "URL is required" >&2; exit 2; }
    echo "Agent API key (CFG pluginu -> DHCP servery -> API kľúč agenta); Enter = keep the current one"
    read -r -p "key: " k
    conf_set NETBOX_URL "$u"
    [ -n "$k" ] && conf_set NETBOX_TOKEN "$k"
    restart_service
    exit 0 ;;
  --once) ONCE=1 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac
log() {
  local line; line="$(date '+%F %T') $*"
  logger -t isc-dhcp-agent -- "$*" 2>/dev/null
  if [ -n "$LOG_FILE" ]; then
    if [ -f "$LOG_FILE" ] && [ "$(du -k "$LOG_FILE" 2>/dev/null | cut -f1)" -gt "${LOG_MAX_KB:-5120}" ]; then mv -f "$LOG_FILE" "$LOG_FILE.1"; fi
    echo "$line" >>"$LOG_FILE" 2>/dev/null
  fi
  [ -t 2 ] && echo "$line" >&2
}
die() { log "ERROR: $*"; exit 1; }

[ -n "$NETBOX_URL" ] || die "NETBOX_URL is not set in $CONF_FILE"
for c in curl sha256sum flock; do command -v "$c" >/dev/null 2>&1 || die "missing command: $c"; done
mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
exec 9>"$LOCK_FILE" || die "cannot open $LOCK_FILE"
flock -n 9 || die "another isc-dhcp-agent is running"

isc_version() {
  command -v "$DHCPD_BIN" >/dev/null 2>&1 || { echo none; return; }
  local v
  v=$("$DHCPD_BIN" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9]+)?' | head -1)
  echo "${v:-unknown}"
}

dhcpd4_pids() {  # PIDs of IPv4 dhcpd processes (a dhcpd -6 is not ours)
  local p
  for p in $(pidof dhcpd 2>/dev/null); do
    tr '\0' ' ' </proc/"$p"/cmdline 2>/dev/null | grep -qE '(^| )-6( |$)' || echo "$p"
  done
}

dhcpd_running() {  # REAL state: an IPv4 dhcpd process exists (it serves DHCP). The service state is reported separately (svc_state).
  if [ -n "$RUNNING_CHECK" ]; then bash -c "$RUNNING_CHECK" >/dev/null 2>&1 && echo 1 || echo 0; return; fi
  [ -n "$(dhcpd4_pids)" ] && echo 1 || echo 0
}

svc_state() {  # active | failed | inactive | activating | ... (none = no systemd)
  command -v systemctl >/dev/null 2>&1 || { echo none; return; }
  local st; st=$(systemctl is-active "$DHCP_SERVICE" 2>/dev/null | head -1); echo "${st:-unknown}"
}

svc_is_active() { [ "$(svc_state)" = active ] || { [ "$(svc_state)" = none ] && [ "$(dhcpd_running)" = 1 ]; }; }

svc_why() {  # short reason from the unit journal why the service is not active ("" when active)
  case "$(svc_state)" in active|none) return 0 ;; esac
  command -v journalctl >/dev/null 2>&1 || return 0
  local j l v6="" ifc hint=""
  j=$(journalctl -u "$DHCP_SERVICE" -n 80 --no-pager -q 2>/dev/null)
  echo "$j" | grep -qE 'DHCPv6 server.*failed|subnet6' && v6=1
  l=$(echo "$j" | grep -iE 'No subnet6? declaration|Address already in use|Not configured|Can.t |no such file|permission denied' | grep -v 'systemd\[' | head -1)
  [ -z "$l" ] && l=$(echo "$j" | grep -iE 'failed!' | tail -1)
  [ -z "$l" ] && l=$(echo "$j" | grep -iE 'fail' | tail -1)
  l=$(echo "$l" | sed -E 's/^.{15} [^ ]+ //; s/^[^ ]+\[[0-9]+\]: //' | cut -c1-140)
  if [ -n "$v6" ]; then
    l="IPv6 server (dhcpd6) fails: $l"
    ifc=$(echo "$j" | grep -oE 'No subnet6 declaration for [^ ]+' | head -1 | awk '{print $NF}')
    if [ -f /etc/init.d/"$DHCP_SERVICE" ]; then
      if [ ! -f /etc/default/"$DHCP_SERVICE" ]; then
        hint=" | /etc/default/$DHCP_SERVICE is missing: the service starts IPv4 AND IPv6 - set INTERFACESv4=\"${ifc:-<interface>}\" INTERFACESv6=\"\""
      elif ! grep -qE '^INTERFACESv4="?[^" ]' /etc/default/"$DHCP_SERVICE"; then
        hint=" | /etc/default/$DHCP_SERVICE has an empty INTERFACESv4: the service starts IPv4 AND IPv6 - set INTERFACESv4=\"${ifc:-<interface>}\" INTERFACESv6=\"\""
      fi
    fi
  fi
  echo "$l$hint" | cut -c1-290
}

dedupe_dhcpd() {  # two or more IPv4 dhcpd at once (e.g. two restarts at the same moment): end ALL, start ONE clean through the service
  local pids n pfs i; pids=$(dhcpd4_pids); n=$(echo "$pids" | grep -c .)
  [ "$n" -gt 1 ] || return 0
  [ "${DEDUPE_BUSY:-}" = 1 ] && return 0
  DEDUPE_BUSY=1; pfs=$(dhcpd_pidfiles)
  log "$n dhcpd processes run at once ($(echo $pids)) - ending ALL and starting one clean"
  kill $pids 2>/dev/null; i=0
  while [ $i -lt 5 ] && [ -n "$(dhcpd4_pids)" ]; do sleep 1; i=$((i+1)); done
  [ -n "$(dhcpd4_pids)" ] && kill -9 $(dhcpd4_pids) 2>/dev/null; sleep 1
  clean_stale_pidfile /dev/null $pfs
  command -v systemctl >/dev/null 2>&1 && systemctl reset-failed "$DHCP_SERVICE" 2>/dev/null
  if [ "$(state admin_stopped)" = 1 ]; then
    log "dhcpd PID: $(echo $pids) -> none  (all ended, stays down: stopped from NetBox)"
  else
    mark_agent; svc start >/dev/null 2>&1; sleep "$START_WAIT"
    log "dhcpd PID: $(echo $pids) -> $(echo $(dhcpd4_pids))  (all ended, one started)"
  fi
  DUP_FIXED="$n dhcpd processes ran at once ($(echo $pids)) - all ended, now: $(echo $(dhcpd4_pids))"
  DEDUPE_BUSY=""
}

diag() {  # full check when something is not OK: last NetBox command, service, every dhcpd process, pidfile, service error
  local out="${1:-/dev/null}" p pf seen="" w
  {
    echo "CHECK last NetBox command: $(state last_cmd || true)"
    echo "CHECK service $DHCP_SERVICE: $(svc_state)"
    for p in $(pidof dhcpd 2>/dev/null); do
      echo "CHECK dhcpd pid $p: $(tr '\0' ' ' </proc/"$p"/cmdline 2>/dev/null | cut -c1-120)$(grep -q "$DHCP_SERVICE" /proc/"$p"/cgroup 2>/dev/null && echo ' (in the service)' || echo ' (OUTSIDE the service)')"
    done
    [ -z "$(pidof dhcpd 2>/dev/null)" ] && echo "CHECK dhcpd process: none"
    for pf in $(dhcpd_pidfiles); do
      pf=$(readlink -f "$pf" 2>/dev/null || echo "$pf"); case " $seen " in *" $pf "*) continue ;; esac; seen="$seen $pf"
      [ -f "$pf" ] && { p=$(cat "$pf" 2>/dev/null); echo "CHECK pidfile $pf: ${p:-empty} $(kill -0 "$p" 2>/dev/null && echo alive || echo DEAD)"; }
    done
    [ "$(dhcpd4_pids | grep -c .)" -gt 1 ] && echo "CHECK WARNING: $(dhcpd4_pids | grep -c .) IPv4 dhcpd processes at once"
    w=$(svc_why); [ -n "$w" ] && echo "CHECK service error: $w"
  } | tee -a "$out" | while IFS= read -r l; do log "$l"; done
}

state() { cat "$STATE_DIR/$1" 2>/dev/null; }

pid_now() { dhcpd4_pids | head -1; }  # first IPv4 dhcpd PID, empty = none

pid_step() {  # pid_step <label> <old-pid>: log "dhcpd PID <old> -> <now> (<label>)" to the log and the report
  local new l; dedupe_dhcpd; new=$(pid_now)
  l="dhcpd PID: ${2:-none} -> ${new:-none}  ($1)"
  echo "$l" >>"${OUT:-/dev/null}"; log "$l"
}

# a path the agent may write / delete: below the base path or the dhcpd.conf in the conf dir, no ".."
safe_path() {
  local p="$1"
  case "$p" in *..*|*" "*|"") return 1 ;; esac
  [ -n "${BASE:-}" ] && case "$p" in "$BASE"/*) return 0 ;; esac
  [ -n "${CONF_DIR:-}" ] && [ "$(dirname "$p")" = "$CONF_DIR" ] && return 0
  return 1
}

allowed() {  # allowed <cmd from NetBox> <local list...> -> the command to run (NetBox one only if allowed locally)
  local want="$1"; shift
  local c
  for c in "$@"; do [ "$c" = "$want" ] && { echo "$c"; return 0; }; done
  echo "$1"; return 1
}

report() {  # report <result> <output file>
  local url="$REPORT_URL" res="$1" out="$2"
  [ -n "$url" ] || return 0
  curl -sS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 60 -o /dev/null -X POST "$url" \
    --data-urlencode "result=$res" --data-urlencode "hash=$HASH" --data-urlencode "running=$(state running)" \
    --data-urlencode "kept=${KEPT:-}" --data-urlencode "leases_kept=${LEASES_KEPT:-}" --data-urlencode "pid=$(pid_now)" --data-urlencode "output@$out" || log "report failed (network)"
}

step() {  # step <code> <n> <text>: one line in the log + a STEP line in the report (NetBox Audit shows the whole flow)
  echo "STEP $1 $2" >>"$OUT"; log "$3"
}

restore() {  # copy the backup back, remove files that did not exist before
  local f n
  for f in "${NEW_FILES[@]}"; do safe_path "$f" && rm -f -- "$f"; done  # only CFG files (base path / dhcpd.conf)
  n=$( [ -d "$BK" ] && find "$BK" -type f ! -path "$BK/_leases/*" | wc -l || echo 0)
  if backup_ok "$(dirname "$BK")" && [ -d "$BK" ] && [ ! -L "$BK" ]; then
    for f in "$BK"/*; do  # CFG files only: the lease copy (_leases) is NEVER put back (old leases = the same IP given twice)
      [ "${f##*/}" = _leases ] && continue
      [ -e "$f" ] && [ ! -L "$f" ] && cp -a "$f" / 2>>"$OUT"
    done
  fi
  step restore "$n" "restored $n CFG file(s) from the backup $BK (leases untouched), removed ${#NEW_FILES[@]} new file(s)"
}

default_fix() {  # Debian init script: empty INTERFACESv4 (or no file) = it starts IPv4 AND IPv6; IPv6 fails -> service failed. Fix it.
  [ "$DEFAULT_FIX" = yes ] || return 0
  local f=/etc/default/"$DHCP_SERVICE" ifs v4 v6 changed=""
  [ -f /etc/init.d/"$DHCP_SERVICE" ] || return 0  # only the LSB init script reads this file
  ifs=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $2}' | sort -u | tr '\n' ' ' | sed 's/ $//')
  [ -n "$ifs" ] || return 0
  if [ ! -f "$f" ]; then
    printf '# created by isc-dhcp-agent: IPv4 DHCP only (IPv6 server off)\nINTERFACESv4="%s"\nINTERFACESv6=""\n' "$ifs" >"$f"
    changed="created $f: INTERFACESv4=\"$ifs\" INTERFACESv6=\"\""
  else
    v4=$(sed -n 's/^INTERFACESv4="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' "$f" | tail -1)
    v6=$(sed -n 's/^INTERFACESv6="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' "$f" | tail -1)
    if [ -z "$v4" ] || [ -n "$v6" ]; then
      [ -f "$f.bak-agent" ] || cp -p "$f" "$f.bak-agent"
      [ -z "$v4" ] && v4="$ifs"
      sed -i '/^INTERFACESv4=/d; /^INTERFACESv6=/d' "$f"
      printf '# set by isc-dhcp-agent: IPv4 DHCP only (IPv6 server off), original in %s.bak-agent\nINTERFACESv4="%s"\nINTERFACESv6=""\n' "$f" "$v4" >>"$f"
      changed="fixed $f: INTERFACESv4=\"$v4\" INTERFACESv6=\"\" (original in $f.bak-agent)"
    fi
  fi
  # a separate IPv6 unit (newer packages) must not start either
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files "${DHCP_SERVICE}6.service" 2>/dev/null | grep -q "^${DHCP_SERVICE}6.service" \
     && [ "$(systemctl is-enabled "${DHCP_SERVICE}6" 2>/dev/null)" != masked ]; then
    systemctl disable --now "${DHCP_SERVICE}6" >/dev/null 2>&1; systemctl mask "${DHCP_SERVICE}6" >/dev/null 2>&1
    changed="${changed:+$changed; }${DHCP_SERVICE}6 (IPv6) disabled and masked"
  fi
  [ -n "$changed" ] || return 0
  log "service settings: $changed"; echo "service settings: $changed" >>"${OUT:-/dev/null}"
  FIXED="${FIXED:+$FIXED; }$changed"
  if [ "$(svc_state)" != active ] && [ "$(state admin_stopped)" != 1 ]; then  # the fix takes effect only with a clean restart
    local p0; p0=$(pid_now); kill_stray "${OUT:-/dev/null}"; mark_agent; svc restart >/dev/null 2>&1; sleep "$START_WAIT"
    pid_step "restart after service settings fix" "$p0"; log "service $DHCP_SERVICE: $(svc_state)"
  fi
}

apparmor_fix() {  # dhcpd confined by AppArmor cannot read <base path>: allow it (only when the kernel uses AppArmor for dhcpd)
  [ "$APPARMOR_FIX" = yes ] && [ -n "${BASE:-}" ] || return 0
  local prof=/etc/apparmor.d/usr.sbin.dhcpd loc=/etc/apparmor.d/local/usr.sbin.dhcpd rule="$BASE/** r,"
  local sec=/sys/kernel/security/apparmor loaded=0
  [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ] || return 0
  grep -q '^/usr/sbin/dhcpd ' "$sec/profiles" 2>/dev/null && loaded=1
  # 1) local rule (used whenever the profile is loaded again, e.g. after a reboot)
  if [ -f "$prof" ] && ! grep -qxF "  $rule" "$loc" 2>/dev/null; then
    mkdir -p "$(dirname "$loc")"
    { echo "  # added by isc-dhcp-agent: dhcpd reads the CFG files from NetBox"; echo "  $BASE/ r,"; echo "  $rule"; } >>"$loc"
    log "AppArmor: rule '$rule' added to $loc"; echo "AppArmor: rule '$rule' added to $loc" >>"$OUT"
    if command -v apparmor_parser >/dev/null 2>&1 && apparmor_parser -r "$prof" 2>>"$OUT"; then
      log "AppArmor: dhcpd profile reloaded with the rule"; AA_RELOADED=1; return 0
    fi
  fi
  # rule exists, tools exist, profile loaded but not reloaded by us since the agent started (e.g. AppArmor just came back): reload once
  if [ "$loaded" = 1 ] && [ -z "${AA_RELOADED:-}" ] && [ -f "$prof" ] && command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r "$prof" 2>>"$OUT" && log "AppArmor: dhcpd profile reloaded with the rule"
    AA_RELOADED=1; return 0
  fi
  # 2) no apparmor_parser (AppArmor tools removed) but the kernel still enforces the old profile: unload it
  if [ "$loaded" = 1 ] && ! command -v apparmor_parser >/dev/null 2>&1; then
    if printf '%s' /usr/sbin/dhcpd >"$sec/.remove" 2>>"$OUT"; then
      log "AppArmor: dhcpd profile unloaded from the kernel (no apparmor_parser to reload it with the rule)"
      echo "AppArmor: dhcpd profile unloaded from the kernel" >>"$OUT"
    else
      log "AppArmor: cannot unload the dhcpd profile - dhcpd cannot read $BASE"
    fi
  fi
}

apply() {
  rm -f "$STATE_DIR/want_up"  # a new CFG supersedes a pending "keep up" retry
  local i tmp rc cmd now prev
  OUT="$WORK/output"; : >"$OUT"
  # 1. download everything to a staging dir and check sha256 (nothing is changed when a file is bad)
  #    fast way: all files in ONE tar.gz; if that fails, file by file
  local bundled=0
  if [ -n "$BUNDLE" ] && command -v tar >/dev/null 2>&1; then
    printf '%s\n' "${DL_PATH[@]}" >"$WORK/paths"
    local t0=$SECONDS
    mkdir -p "$WORK/b"
    if curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 300 -X POST "$BUNDLE" --data-urlencode "paths@$WORK/paths" -o "$WORK/b.tgz" 2>>"$OUT" \
       && tar -m --no-same-owner --no-same-permissions -xzf "$WORK/b.tgz" -C "$WORK/b" 2>>"$OUT" \
       && { [ -z "$(find "$WORK/b" ! -type f ! -type d -print -quit)" ] || { echo "SECURITY: bundle contains links or special files - refused" >>"$OUT"; log "SECURITY: bundle contains links or special files - refused"; false; }; }; then
      bundled=1
      log "downloaded bundle (tar.gz): $(du -k "$WORK/b.tgz" | cut -f1) KB in $((SECONDS - t0)) s"
      for i in "${!DL_PATH[@]}"; do
        safe_path "${DL_PATH[$i]}" || { echo "refused path ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
        if [ -f "$WORK/b${DL_PATH[$i]}" ] && [ "$(sha256sum "$WORK/b${DL_PATH[$i]}" | cut -d' ' -f1)" = "${DL_SHA[$i]}" ]; then
          mv "$WORK/b${DL_PATH[$i]}" "$WORK/f$i"
        else
          bundled=0; echo "bundle: missing or bad ${DL_PATH[$i]} - downloading file by file" >>"$OUT"; log "bundle: missing or bad ${DL_PATH[$i]} - downloading file by file"; break
        fi
      done
    else
      echo "bundle download failed - downloading file by file" >>"$OUT"; log "bundle download failed - downloading file by file"
    fi
  elif [ -n "$BUNDLE" ]; then
    log "tar not found - downloading file by file"
  fi
  [ "$bundled" = 1 ] && log "sha256 OK for all ${#DL_PATH[@]} files"
  [ "$bundled" = 1 ] || log "downloading ${#DL_PATH[@]} files one by one"
  [ "$bundled" = 1 ] || for i in "${!DL_PATH[@]}"; do
    safe_path "${DL_PATH[$i]}" || { echo "refused path ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
    curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 120 -o "$WORK/f$i" "${DL_URL[$i]}" 2>>"$OUT" \
      || { echo "download failed: ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
    [ "$(sha256sum "$WORK/f$i" | cut -d' ' -f1)" = "${DL_SHA[$i]}" ] \
      || { echo "sha256 mismatch: ${DL_PATH[$i]}" >>"$OUT"; report failed "$OUT"; return; }
  done
  step download "${#DL_PATH[@]}" "downloaded ${#DL_PATH[@]} file(s), sha256 OK"
  # 2. backup = cp of ONLY the files that will be replaced (a restore puts back exactly these)
  prev=$(state label); now=$(date +%Y%m%d-%H%M%S)
  [[ "$prev" =~ ^[0-9]{2}\.[0-9]{2}\.[0-9]{2}_[0-9]{1,6}$ ]] || prev=start
  if ! backup_ok "$BACKUP_TO"; then
    [ -n "$BACKUP_TO" ] && { echo "backup dir $BACKUP_TO from NetBox refused (only below /opt) - using $BACKUP_DEFAULT" >>"$OUT"; log "SECURITY: backup dir $BACKUP_TO from NetBox refused (only below /opt) - using $BACKUP_DEFAULT"; }
    BACKUP_TO="$BACKUP_DEFAULT"
  fi
  backup_ok "$BACKUP_TO" || { echo "no safe backup dir (only below /opt): $BACKUP_TO" >>"$OUT"; report failed "$OUT"; return; }
  BK="$BACKUP_TO/${prev}_$now"
  echo "$BACKUP_TO" >"$STATE_DIR/backup_dir"  # where the backups are (NetBox shows the original CFG backup start_*)
  mkdir -p "$BK" || { echo "cannot create backup $BK" >>"$OUT"; report failed "$OUT"; return; }
  local nb=0 bf=0
  for i in "${DL_PATH[@]}"; do
    [ -e "$i" ] || continue
    if cp -a --parents "$i" "$BK/" 2>>"$OUT"; then nb=$((nb + 1)); else bf=$((bf + 1)); fi
  done
  for i in "${DELETES[@]}"; do  # files to be deleted too
    [ -f "$i" ] && [ ! -L "$i" ] && safe_path "$i" || continue
    if cp -a --parents "$i" "$BK/" 2>>"$OUT"; then nb=$((nb + 1)); else bf=$((bf + 1)); fi
  done
  if [ "$bf" -gt 0 ]; then  # no full backup = no safe way back: change nothing (disk full?)
    echo "BACKUP FAILED for $bf file(s) - nothing was changed (disk full?)" >>"$OUT"
    log "backup FAILED for $bf file(s) in $BK - CFG NOT applied, nothing changed"
    report failed "$OUT"; return
  fi
  # DHCP lease database (who has which IP): copied before every restart, NEVER restored or deleted by the agent
  local lf nl=0
  mkdir -p "$BK/_leases"
  for lf in "$LEASES_FILE" "$LEASES_FILE~"; do [ -f "$lf" ] && [ ! -L "$lf" ] && cp -a "$lf" "$BK/_leases/" 2>>"$OUT" && nl=$((nl + 1)); done
  echo "backup: $BK" >>"$OUT"
  step backup "$nb" "backup: $nb file(s) that will be replaced or deleted + $nl lease file(s) ($LEASES_FILE) -> $BK"
  # 3. install (order from NetBox: included files first, dhcpd.conf last)
  NEW_FILES=()
  for i in "${!DL_PATH[@]}"; do
    tmp="${DL_PATH[$i]}"
    [ -e "$tmp" ] || NEW_FILES+=("$tmp")
    mkdir -p -m 755 "$(dirname "$tmp")" && chmod 755 "$(dirname "$tmp")" && install -m 644 "$WORK/f$i" "$tmp.isc-new" && mv -f "$tmp.isc-new" "$tmp" \
      || { echo "install failed: $tmp" >>"$OUT"; restore; report failed "$OUT"; return; }
  done
  step install "${#DL_PATH[@]}" "applied ${#DL_PATH[@]} file(s) (dhcpd.conf last)"
  # 4. test (AppArmor rule first, if the system uses AppArmor for dhcpd)
  apparmor_fix
  cmd=$(allowed "$TEST_CMD" "${ALLOWED_TEST_CMDS[@]}") || echo "test command from NetBox not allowed locally, used: $cmd" >>"$OUT"
  echo "\$ $cmd" >>"$OUT"
  bash -c "$cmd" >>"$OUT" 2>&1; rc=$?
  if [ $rc -ne 0 ]; then
    step test fail "test FAILED (rc=$rc) - dhcpd -t says:"
    grep -v '^\$ \|^backup: \|^Internet Systems\|^Copyright\|^All rights\|^For info\|^$' "$OUT" | tail -n 25 | while IFS= read -r l; do log "  $l"; done
    if [ "$ON_FAIL" = keep ] || [ -z "$(state running)" ]; then  # debugging switch, or the FIRST CFG (nothing to go back to): keep it, never restart
      echo "KEPT: the new CFG stays on disk (debugging), dhcpd was not restarted" >>"$OUT"
      step kept 0 "new CFG kept on disk (first CFG or NetBox switch) - dhcpd NOT restarted"
      KEPT=1; report test_failed "$OUT"; KEPT=""; return
    fi
    restore; report test_failed "$OUT"; return
  fi
  step test ok "test OK (dhcpd -t)"
  if [ "$(state admin_stopped)" = 1 ]; then  # stopped from NetBox: deploy + test only, dhcpd stays down until Start
    step kept_stopped 0 "CFG deployed and tested - dhcpd stays stopped (Stop from NetBox), start it with Start"
    local nd0=0
    for i in "${DELETES[@]}"; do [ -n "$BASE" ] && case "$i" in "$BASE"/*) true ;; *) false ;; esac && safe_path "$i" && rm -f -- "$i" && nd0=$((nd0 + 1)); done
    echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"; APPLIED=1
    log "CFG $CFG applied (${#DL_PATH[@]} files, $nd0 deleted) - dhcpd stays stopped"
    report ok "$OUT"; prune_backups; return
  fi
  # 5. restart + check that dhcpd runs
  cmd=$(allowed "$RESTART_CMD" "${ALLOWED_RESTART_CMDS[@]}") || echo "restart command from NetBox not allowed locally, used: $cmd" >>"$OUT"
  echo "\$ $cmd" >>"$OUT"
  mark_agent; rm -f "$STATE_DIR/admin_stopped"
  local first="" lb=""; LEASES_KEPT=""
  if [ -z "$(state running)" ] && [ -f "$LEASES_FILE" ]; then  # FIRST NetBox CFG on this server: keep the dynamic IPs exactly as they were
    first=1; step leases_stop 0 "first deployment: stopping dhcpd to keep its leases"
    svc stop >>"$OUT" 2>&1; wait_down 10
    mkdir -p "$BK/_leases"; cp -a "$LEASES_FILE" "$BK/_leases/" 2>>"$OUT"; [ -f "$LEASES_FILE~" ] && cp -a "$LEASES_FILE~" "$BK/_leases/" 2>>"$OUT"
    lb=$(lease_ips "$LEASES_FILE"); log "first deployment: leases copied after stop ($lb IP) -> $BK/_leases"
  fi
  step restart 0 "restarting dhcpd"
  local p0; p0=$(pid_now); kill_stray "$OUT"; bash -c "$cmd" >>"$OUT" 2>&1
  sleep "$START_WAIT"; pid_step "restart" "$p0"
  if [ "$(dhcpd_running)" != 1 ]; then
    step notrunning 0 "dhcpd did NOT start - restoring"; restore
    kill_stray "$OUT"; bash -c "$cmd" >>"$OUT" 2>&1; sleep "$START_WAIT"
    echo "dhcpd after restore: $( [ "$(dhcpd_running)" = 1 ] && echo running || echo NOT running )" >>"$OUT"
    report rolled_back "$OUT"; return
  fi
  step running 0 "dhcpd is running"
  if [ -n "$first" ]; then  # the leases file must still hold every IP it had (dhcpd reads it on start)
    local la; la=$(lease_ips "$LEASES_FILE")
    LEASES_KEPT="$lb|$la|$BK/_leases"
    if [ "$la" -lt "$lb" ]; then log "WARNING: leases after start $la IP < before $lb IP - the copy is in $BK/_leases"; else log "leases kept: $lb IP before -> $la IP after start"; fi
  fi
  # 6. delete files the plugin does not generate any more (only managed paths)
  local nd=0
  for i in "${DELETES[@]}"; do [ -n "$BASE" ] && case "$i" in "$BASE"/*) true ;; *) false ;; esac && safe_path "$i" && rm -f -- "$i" && echo "deleted $i" >>"$OUT" && nd=$((nd + 1)); done
  [ "$nd" -gt 0 ] && step delete "$nd" "deleted $nd file(s) the plugin no longer generates"
  # 7. remember + report
  echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"; APPLIED=1
  log "CFG $CFG applied (${#DL_PATH[@]} files, ${#DELETES[@]} deleted, dhcpd pid $(pid_now))"
  rm -f "$STATE_DIR/want_up"; report ok "$OUT"
  # keep the newest backups only
  prune_backups
}

backup_ok() {  # backup dir: ONLY below /opt (/opt/<name>[/...]), plain names, no symlink leading elsewhere
  local p="${1%/}" r
  [[ "$p" =~ ^/opt/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]] || return 1
  case "$p/" in */../*|*/./*) return 1 ;; esac
  r=$(realpath -m -- "$p" 2>/dev/null) || return 1
  [[ "$r" =~ ^/opt/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$ ]]
}

prune_backups() {  # keep the newest KEEP_BACKUPS; removes ONLY the agent's own backup dirs <CFG>_<YYYYmmdd-HHMMSS> below /opt
  backup_ok "$BACKUP_TO" || return 0
  local d b
  ls -1dt "$BACKUP_TO"/*/ 2>/dev/null | while read -r d; do
    d="${d%/}"; b="${d##*/}"
    [ -L "$d" ] && continue
    [[ "$b" =~ ^([0-9]{2}\.[0-9]{2}\.[0-9]{2}_[0-9]{1,6}|start)_[0-9]{8}-[0-9]{6}$ ]] || continue
    [ "$(dirname "$d")" = "${BACKUP_TO%/}" ] && echo "$d"
  done | tail -n +"$((KEEP_BACKUPS + 1))" | while read -r d; do rm -rf -- "$d"; done
}

origin() { echo "$NETBOX_URL" | sed -E 's#^(https?://[^/]+).*#\1#'; }

rebase() {  # a URL from NetBox -> same path on the NetBox address this agent uses (never another host / scheme, the key goes with it)
  [ -n "$1" ] || return 0
  printf '%s%s' "$(origin)" "$(echo "$1" | sed -E 's#^[A-Za-z]+://[^/]+##')"
}

base_ok() {  # a base path the agent may write to: absolute, 2+ levels, not a system directory (/etc/dhcp/... is fine)
  local p="${1%/}"
  case "$p" in /*) ;; *) return 1 ;; esac
  case "$p" in *..*|*" "*|*//*) return 1 ;; esac
  [ "$(printf '%s' "$p" | tr -cd / | wc -c)" -ge 2 ] || return 1
  case "$p/" in
    /etc/dhcp/*) return 0 ;;
    /etc/*|/usr/*|/bin/*|/sbin/*|/lib/*|/lib32/*|/lib64/*|/boot/*|/root/*|/proc/*|/sys/*|/dev/*|/run/*|/var/run/*|/var/lib/dpkg/*|/var/lib/apt/*|/var/spool/cron/*) return 1 ;;
  esac
  return 0
}

conf_set_quiet() { ( conf_set "$1" "$2" ) >/dev/null 2>&1; }  # never ends the daemon on a bad value

check_paths() {  # NetBox decides WHICH files, this server decides WHERE: conf dir fixed, base path pinned (ALLOWED_BASE)
  local msg=""
  if [ -n "$CONF_DIR" ] && [ "${CONF_DIR%/}" != "${DHCP_CONF_DIR%/}" ]; then
    msg="NetBox sent conf dir $CONF_DIR - ignored, this server uses $DHCP_CONF_DIR (DHCP_CONF_DIR)"
  fi
  CONF_DIR="${DHCP_CONF_DIR%/}"
  BASE_REFUSED=""
  if [ -n "$BASE" ]; then
    BASE="${BASE%/}"
    if ! base_ok "$BASE"; then
      BASE_REFUSED="base path $BASE from NetBox is a system directory or not safe - refused"; BASE=""
    elif [ -z "$ALLOWED_BASE" ]; then
      if conf_set_quiet ALLOWED_BASE "$BASE"; then
        ALLOWED_BASE="$BASE"; log "base path $BASE accepted and pinned in $CONF_FILE (ALLOWED_BASE) - a different one from NetBox will be refused"
      fi
    elif [ "$BASE" != "${ALLOWED_BASE%/}" ]; then
      BASE_REFUSED="base path $BASE from NetBox differs from ALLOWED_BASE=$ALLOWED_BASE on this server - refused (to allow it: isc-dhcp-agent --set ALLOWED_BASE $BASE)"; BASE=""
    fi
  fi
  [ -n "$BASE_REFUSED" ] && msg="${msg:+$msg; }$BASE_REFUSED"
  if [ "$msg" != "$(state path_msg)" ]; then echo "$msg" >"$STATE_DIR/path_msg"; [ -n "$msg" ] && log "SECURITY: $msg"; fi
  local d keep=(); for d in "${DIRS[@]}"; do [ -n "$BASE" ] && case "$d" in "$BASE"|"$BASE"/*) keep+=("$d") ;; esac; done; DIRS=("${keep[@]}")
}

netbox_urls() {  # addresses to try, in order: the set one (any port) -> same port other scheme -> 443 https -> 80 http
  local u="$NETBOX_URL" host port path out=() x seen=" "
  host=$(echo "$u" | sed -E 's#^[A-Za-z]+://([^/:]+).*#\1#')
  port=$(echo "$u" | sed -nE 's#^[A-Za-z]+://[^/:]+:([0-9]+).*#\1#p')
  path=$(echo "$u" | sed -E 's#^[A-Za-z]+://[^/]+##')
  out+=("$u")
  [ -n "$port" ] && out+=("$(other_scheme "$u")")
  out+=("https://$host$path" "http://$host$path")
  for x in "${out[@]}"; do
    case "$x" in http://*) [ "$ALLOW_HTTP" = yes ] || continue ;; esac
    case "$seen" in *" $x "*) continue ;; esac; seen="$seen$x "; echo "$x"
  done
}

other_scheme() {  # https://x -> http://x and back
  case "$1" in https://*) echo "http://${1#https://}" ;; http://*) echo "https://${1#http://}" ;; *) echo "$1" ;; esac
}

save_url() {  # remember the working URL in the config file
  [ -w "$CONF_FILE" ] && sed -i "s|^NETBOX_URL=.*|NETBOX_URL=\"$1\"|" "$CONF_FILE" && log "NETBOX_URL changed to $1 (saved in $CONF_FILE)"
}

svc() {  # svc <start|stop|restart>: the DHCP service, without any command from NetBox
  if command -v systemctl >/dev/null 2>&1; then systemctl "$1" "$DHCP_SERVICE"; else service "$DHCP_SERVICE" "$1"; fi
}

dhcpd_pidfiles() {  # pidfile from a running dhcpd (-pf arg), plus the Debian defaults
  local pid pf
  for pid in $(pidof dhcpd 2>/dev/null); do
    pf=$(tr '\0' ' ' </proc/"$pid"/cmdline 2>/dev/null | grep -oE '(^| )-pf +[^ ]+' | awk '{print $NF}')
    [ -n "$pf" ] && echo "$pf"
  done
  echo /run/dhcpd.pid; echo /var/run/dhcpd.pid
}

clean_stale_pidfile() {  # a pidfile left by a crashed / killed dhcpd points to a dead pid and blocks a clean start (start-stop-daemon)
  local out="$1"; shift; local pf p seen=""
  for pf in "$@"; do
    case " $seen " in *" $pf "*) continue ;; esac; seen="$seen $pf"
    [[ "$pf" =~ ^/(var/)?run/[A-Za-z0-9._/-]+\.pid$ ]] && [[ "$pf" != *..* ]] || continue  # pidfiles only in /run
    [ -f "$pf" ] || continue
    p=$(cat "$pf" 2>/dev/null)
    if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then
      rm -f "$pf" && { echo "removed stale pidfile $pf (pid ${p:-empty} dead)" >>"$out"; log "removed stale pidfile $pf (pid ${p:-empty} dead)"; }
    fi
  done
}

kill_stray() {  # dhcpd processes while the service is not active (started by hand / left by a failed start): end them + clear a stale pidfile; both block a clean start
  svc_is_active && [ "$(dhcpd_running)" = 1 ] && return 0  # healthy service with its dhcpd: never touch it
  local out="${1:-/dev/null}" pfs; pfs=$(dhcpd_pidfiles)  # read -pf while a process may still be alive
  if [ -z "$(dhcpd4_pids)" ]; then
    command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$DHCP_SERVICE" 2>/dev/null && systemctl stop "$DHCP_SERVICE" >/dev/null 2>&1  # crashed: service "active" without a process
    clean_stale_pidfile "$out" $pfs; return 0
  fi
  local p0; p0=$(pid_now)
  echo "dhcpd process without a working service (pid $p0, service $(svc_state)) - ending it for a clean start" >>"$out"
  log "dhcpd process without a working service (pid $p0, service $(svc_state)) - ending it for a clean start"
  kill $(dhcpd4_pids) 2>/dev/null; local i=0
  while [ $i -lt 5 ] && [ -n "$(dhcpd4_pids)" ]; do sleep 1; i=$((i+1)); done
  [ -n "$(dhcpd4_pids)" ] && kill -9 $(dhcpd4_pids) 2>/dev/null; sleep 1
  command -v systemctl >/dev/null 2>&1 && systemctl reset-failed "$DHCP_SERVICE" 2>/dev/null
  clean_stale_pidfile "$out" $pfs; pid_step "kill stray" "$p0"; return 0
}

wait_down() { local i=0; while [ $i -lt "$1" ] && [ "$(dhcpd_running)" = 1 ]; do sleep 1; i=$((i+1)); done; }

prune_own() {  # keep the newest 10 own dirs <prefix>YYYYmmdd-HHMMSS in a backup dir below /opt (test servers make many)
  local d="$1" pre="$2" n
  backup_ok "$d" || return 0
  ls -1 "$d" 2>/dev/null | grep -E "^${pre}[0-9]{8}-[0-9]{6}$" | sort -r | tail -n +11 | while read -r n; do
    [ -d "$d/$n" ] && [ ! -L "$d/$n" ] && rm -rf -- "${d:?}/$n"
  done
}

disk_usage() {  # use% of the file systems the agent writes to: "mount:pct,..." (backup dir, base path, leases, /)
  local p q seen=" " out="" line
  for p in "$(state leases_cfg | cut -d'|' -f3)" "$BACKUP_DEFAULT" "${ALLOWED_BASE:-}" "$(dirname "$LEASES_FILE")" /; do
    [ -n "$p" ] || continue
    q="$p"; while [ ! -e "$q" ] && [ "$q" != / ]; do q=$(dirname "$q"); done
    line=$(df -P "$q" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $6":"$5}')
    [ -n "$line" ] || continue
    case "$seen" in *" ${line%%:*} "*) continue ;; esac
    seen="$seen${line%%:*} "; out="${out:+$out,}$line"
  done
  echo "$out"
}

first_cfg_info() {  # the agent's backup of the ORIGINAL CFG (made before the first NetBox CFG, start_<time>): "path|files|KB,..." for NetBox
  local d b out=""
  for d in "$(state backup_dir)" "$BACKUP_DEFAULT"; do
    backup_ok "$d" || continue
    for b in "${d%/}"/start_*; do
      [ -d "$b" ] && [ ! -L "$b" ] && [[ "${b##*/}" =~ ^start_[0-9]{8}-[0-9]{6}$ ]] || continue
      case ",$out" in *",$b|"*) continue ;; esac
      out="${out:+$out,}$b|$(find "$b" -type f ! -path "$b/_leases/*" | wc -l)|$(du -sk "$b" 2>/dev/null | cut -f1)"
    done
  done
  echo "$out"
}

lease_ips() { [ -f "$1" ] && grep -oE '^lease [0-9.]+' "$1" | sort -u | wc -l || echo 0; }  # different IPs in a leases file

first_leases() {  # first run of the agent on this server: copy the ORIGINAL leases once, whatever the lease copy setting is
  [ -n "$(state first_leases)" ] && return 0
  [ -f "$LEASES_FILE" ] && [ ! -L "$LEASES_FILE" ] || return 0
  local dir now name
  dir=$(state leases_cfg | cut -d'|' -f3); backup_ok "$dir" || dir="$BACKUP_DEFAULT/leases"
  now=$(date +%s); name="$dir/original_$(date -d "@$now" +%Y%m%d-%H%M%S)"
  mkdir -p "$name" && cp -a "$LEASES_FILE" "$name/" || { log "first run: copy of the original leases FAILED -> $name"; return 0; }
  [ -f "$LEASES_FILE~" ] && cp -a "$LEASES_FILE~" "$name/"
  echo "$now|$(lease_ips "$LEASES_FILE")|$(sha256sum "$LEASES_FILE" | cut -d' ' -f1)|$name" >"$STATE_DIR/first_leases"
  prune_own "$dir" original_
  log "first run of the agent: original leases copied -> $name ($(lease_ips "$LEASES_FILE") IP)"
}

applied_add() { grep -qxF "$1" "$STATE_DIR/applied" 2>/dev/null || echo "$1" >>"$STATE_DIR/applied"; }  # settings taken over -> told to NetBox (Audit: done)

mark_agent() { echo 1 >"$STATE_DIR/agent_did"; }  # dhcpd started/stopped by the agent (not by hand)

test_stop() {  # stop dhcpd like Stop from NetBox: wait for a running start to finish, stop the service, end a dhcpd left outside it
  local p0 i=0; p0=$(pid_now)
  while [ $i -lt 30 ] && case "$(svc_state)" in activating|reloading|deactivating) true ;; *) false ;; esac; do sleep 2; i=$((i+1)); done  # a stop during "activating" leaves dhcpd running
  mark_agent; svc stop >/dev/null 2>&1; wait_down 5
  [ -n "$(dhcpd4_pids)" ] && kill_stray
  pid_step stop "$p0"
}

test_keep_off() {  # TEST server stopped from NetBox must never run (started by hand, by the system, ...): stop it again. Production servers: never.
  [ "$(state is_test)" = 1 ] && [ "$(state admin_stopped)" = 1 ] && [ "$(dhcpd_running)" = 1 ] || return 0
  test_stop
  if [ "$(dhcpd_running)" = 1 ]; then
    log "test server: dhcpd must stay stopped (stopped from NetBox) but it runs - stopping it FAILED"
    FIXED="${FIXED:+$FIXED; }test server: dhcpd must stay stopped (stopped from NetBox), it was running - stopping it FAILED"
  elif [ -n "${REBOOT:-}" ]; then  # after a reboot: reported as "rebooted - test server stopped again"
    REBOOT_STOP=1; echo "$BOOT_NOW" >"$STATE_DIR/reboot_done"
    log "server rebooted: test server, dhcpd was stopped from NetBox before the reboot - stopped it again"
  else
    log "test server: dhcpd must stay stopped (stopped from NetBox) but it was running - stopped it"
    FIXED="${FIXED:+$FIXED; }test server: dhcpd must stay stopped (stopped from NetBox), it was running - the agent stopped it"
  fi
}

reboot_check() {  # REBOOT=1 when the server booted since the last contact NetBox accepted (boot id of the kernel)
  BOOT_NOW=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  local prev; prev=$(state boot_id); REBOOT=""; REBOOT_STOP=""
  [ -n "$BOOT_NOW" ] && [ -n "$prev" ] && [ "$prev" != "$BOOT_NOW" ] && REBOOT=1
  # test server stopped from NetBox before the reboot, but systemd started dhcpd at boot: stop it again (production servers: never)
  if [ -n "$REBOOT" ] && [ "$(state is_test)" = 1 ] && [ "$(state admin_stopped)" = 1 ] && [ "$(dhcpd_running)" = 1 ] && [ "$(state reboot_done)" != "$BOOT_NOW" ]; then
    test_stop
    if [ "$(dhcpd_running)" = 1 ]; then
      log "server rebooted: test server was stopped from NetBox before the reboot - stopping dhcpd FAILED, it keeps running"
    else
      REBOOT_STOP=1; echo "$BOOT_NOW" >"$STATE_DIR/reboot_done"
      log "server rebooted: test server, dhcpd was stopped from NetBox before the reboot - stopped it again"
    fi
  fi
  [ -n "$REBOOT" ] && [ "$(state is_test)" = 1 ] && [ "$(state reboot_done)" = "$BOOT_NOW" ] && REBOOT_STOP=1  # NetBox not reached yet: still report it
  return 0
}

dhcpd_event() {  # agent_start | agent_stop | agent_restart | manual_start | manual_stop | manual_restart since the last contact NetBox accepted ("" = no change)
  local now prev who pp
  now=$(dhcpd_running); prev=$(state dhcpd_prev); pp=$(state pid_prev)
  EVENT_NOW="$now"; PID_NOW=$(pid_now)
  [ -z "$prev" ] && return 0
  if [ -n "${REBOOT:-}" ]; then  # the server booted since the last contact: dhcpd started by systemd at boot = normal, not "by hand"
    if [ -n "${REBOOT_STOP:-}" ]; then echo reboot_stopped; elif [ "$now" = 1 ]; then echo reboot_up; else echo reboot_down; fi
    return 0
  fi
  who=manual; [ "$(state agent_did)" = 1 ] && who=agent
  if [ "$now" = "$prev" ]; then  # still running, but another PID and not the agent's doing = restarted by hand
    [ "$now" = 1 ] && [ -n "$pp" ] && [ -n "$PID_NOW" ] && [ "$pp" != "$PID_NOW" ] && echo "${who}_restart"  # agent_restart = the agent did it (new PID is the agent's)
    return 0
  fi
  [ "$now" = 1 ] && echo "${who}_start" || echo "${who}_stop"
}

who_on() {  # " | logged in: user (tty, from)" - who was on the server (root commands are not in the journal with a user)
  command -v who >/dev/null 2>&1 || return 0
  local w; w=$(who 2>/dev/null | awk '{f=$NF; if (f ~ /^\(/) {gsub(/[()]/,"",f)} else {f="local"} k=$1" ("$2", "f")"; if (!(k in seen)) {seen[k]=1; printf "%s%s", (n++?", ":""), k}}')
  [ -n "$w" ] && printf ' | logged in: %s' "$w" | cut -c1-160
}

why_changed() {  # $1 = start|stop|restart: what the system logged since the last contact (sudo command, systemd unit, kernel crash)
  command -v journalctl >/dev/null 2>&1 || { echo "no journal - cannot tell"; return; }
  local since; since=$(state contact_ts); since="@${since:-$(( $(date +%s) - 600 ))}"
  local l
  if [ "$1" = stop ]; then
    l=$(journalctl -k --since "$since" --no-pager -q 2>/dev/null | grep -iE 'dhcpd.*(segfault|killed process|out of memory|general protection)|oom-kill.*dhcpd' | tail -1)
    [ -n "$l" ] && { echo "CRASH: $(echo "$l" | sed -E 's/^.{16}[^ ]+ kernel: //' | cut -c1-200)"; return; }
  fi
  l=$(journalctl --since "$since" --no-pager -q _COMM=sudo 2>/dev/null | grep -E 'COMMAND=.*(isc-dhcp-server|dhcpd)' | tail -1)
  [ -n "$l" ] && { echo "command (sudo): $(echo "$l" | sed -E 's/.*sudo\[[0-9]+\]: *([^ ]+) *:.*COMMAND=/\1: /' | cut -c1-200)"; return; }
  if [ "$1" = stop ]; then
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -E 'Stopping|Stopped|Deactivated' | tail -1)
    [ -n "$l" ] && { echo "command: systemctl/service stop (root)$(who_on)"; return; }
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -iE 'exit|fail|signal|killed' | tail -1)
    [ -n "$l" ] && { echo "crash/kill: $(echo "$l" | sed -E 's/^.{16}[^ ]+ //' | cut -c1-150)"; return; }
    l=$(journalctl --since "$since" --no-pager -q 2>/dev/null | grep -E 'dhcpd\[[0-9]+\]' | tail -1)
    [ -n "$l" ] && { echo "crash/kill (no stop command), last dhcpd log: $(echo "$l" | sed -E 's/^.{16}[^ ]+ //' | cut -c1-150)"; return; }
    echo "crash/kill (no stop command in the journal)"
  else
    l=$(journalctl -u "$DHCP_SERVICE" --since "$since" --no-pager -q 2>/dev/null | grep -E 'Starting|Started' | tail -1)
    [ -n "$l" ] && { echo "command: systemctl/service $([ "$1" = restart ] && echo restart || echo start) (root)$(who_on)"; return; }
    echo "dhcpd started directly (not through the service)$(who_on)"
  fi
}

event_sent() {  # NetBox accepted the contact: remember the state (an event is never lost on 503 / NetBox down)
  local old_pid; old_pid=$(state pid_prev)
  [ -n "${EVENT_NOW:-}" ] && echo "$EVENT_NOW" >"$STATE_DIR/dhcpd_prev"
  [ -n "${BOOT_NOW:-}" ] && echo "$BOOT_NOW" >"$STATE_DIR/boot_id" && rm -f "$STATE_DIR/reboot_done"  # the reboot is reported
  echo "${PID_NOW:-}" >"$STATE_DIR/pid_prev"
  rm -f "$STATE_DIR/agent_did"
  [ -n "${LEASES_EV:-}" ] && [ "$(state leases_event)" = "$LEASES_EV" ] && rm -f "$STATE_DIR/leases_event"
  [ -n "${APPLIED_EV:-}" ] && [ "$(state applied | tr '\n' ',')" = "$APPLIED_EV" ] && rm -f "$STATE_DIR/applied"
  date +%s >"$STATE_DIR/contact_ts"
  case "${LOG_EVENT:-$EVENT}" in
    manual_stop) log "dhcpd stopped outside the agent: $LOG_WHY - reported to NetBox" ;;
    manual_start) log "dhcpd started outside the agent: $LOG_WHY - reported to NetBox" ;;
    manual_restart) log "dhcpd restarted outside the agent (PID $old_pid -> $PID_NOW): $LOG_WHY - reported to NetBox" ;;
    reboot_up) log "server rebooted - dhcpd started by the system (PID $PID_NOW), normal - reported to NetBox" ;;
    reboot_down) log "server rebooted - dhcpd is NOT running - reported to NetBox" ;;
    reboot_stopped) log "server rebooted - test server, dhcpd was stopped from NetBox before the reboot: stopped again - reported to NetBox" ;;
  esac
}

run_cmd() {  # command from NetBox (start | stop | restart | update), once per id; result goes back with the next contact
  [ -n "$CMD" ] && [ -n "$CMD_ID" ] || return 0
  [ "$(state cmd_done | cut -d: -f1)" = "$CMD_ID" ] && return 0
  local res=ok txt="" out="$WORK/cmd" rc
  : >"$out"
  case "$CMD" in
    stop)
      echo 1 >"$STATE_DIR/admin_stopped"; rm -f "$STATE_DIR/want_up"; mark_agent
      svc stop >"$out" 2>&1 || true; wait_down 5
      txt="dhcpd stopped"
      if [ -n "$(dhcpd4_pids)" ]; then kill_stray "$out"; txt="dhcpd stopped (process left by the service ended)"; fi
      [ "$(dhcpd_running)" = 1 ] && { res=failed; txt="dhcpd still running: $(grep -v '^$' "$out" | tail -1)"; } ;;
    start|restart)
      rm -f "$STATE_DIR/admin_stopped"
      echo 1 >"$STATE_DIR/want_up"; date +%s >"$STATE_DIR/want_up_ts"  # keep dhcpd up: retry every ~minute until it runs
      local tcmd p0; tcmd="${TEST_CMD:-${ALLOWED_TEST_CMDS[0]}}"; tcmd=$(allowed "$tcmd" "${ALLOWED_TEST_CMDS[@]}")
      bash -c "$tcmd" >"$out" 2>&1; rc=$?
      if [ $rc -ne 0 ]; then
        rm -f "$STATE_DIR/want_up"  # bad CFG -> this IS a CFG problem, do not retry
        res=failed; txt="dhcpd -t failed: $(grep -i -m1 -E 'line [0-9]+|error|denied|can.t' "$out")"
      else
        OUT="$out"; p0=$(pid_now); kill_stray "$out"; mark_agent; svc "$CMD" >>"$out" 2>&1; sleep "$START_WAIT"; pid_step "$CMD" "$p0"; OUT=""
        if [ "$(dhcpd_running)" = 1 ]; then rm -f "$STATE_DIR/want_up"; txt="dhcpd running (pid $(pid_now))"
        else res=failed; txt="dhcpd did not start (CFG is OK) - retrying every minute"; fi
      fi ;;
    update)
      local self new="$WORK/agent.new"; self=$(readlink -f "$0")
      if [ -z "$AGENT_URL" ] || ! curl -fsS "${CURL_OPTS[@]}" "${AUTH[@]}" --max-time 120 -o "$new" "$AGENT_URL" 2>"$out"; then
        res=failed; txt="download failed"
      elif [ "$(sha256sum "$new" | cut -d' ' -f1)" != "$AGENT_SHA" ]; then
        res=failed; txt="sha256 mismatch"
      elif ! bash -n "$new" 2>>"$out"; then
        res=failed; txt="new agent has a syntax error"
      else
        txt="updated to $(grep -m1 '^AGENT_VERSION=' "$new" | cut -d'"' -f2)"
        echo "$CMD_ID:$res:$txt" >"$STATE_DIR/cmd_done"
        install -m 755 "$new" "$self" && log "agent $txt - restarting the agent"
        [ "$ONCE" = 1 ] || { command -v systemctl >/dev/null 2>&1 && systemctl --no-block restart isc-dhcp-agent; }
        return 0
      fi ;;
    restoreleases)  # put the ORIGINAL leases (copy from the first run) back: test CFG -> stop -> keep current -> copy back -> start
      local orig bk tc; orig=$(state first_leases | cut -d'|' -f4)
      tc="${TEST_CMD:-${ALLOWED_TEST_CMDS[0]}}"; tc=$(allowed "$tc" "${ALLOWED_TEST_CMDS[@]}")
      if [ -z "$orig" ] || [ ! -f "$orig/dhcpd.leases" ] || ! backup_ok "$(dirname "$orig")"; then
        res=failed; txt="no copy of the original leases on this server"
      elif ! bash -c "$tc" >"$out" 2>&1; then
        res=failed; txt="CFG test failed - leases not restored: $(grep -i -m1 -E 'line [0-9]+|error' "$out")"
      else
        mark_agent; svc stop >>"$out" 2>&1; wait_down 10
        bk="$(dirname "$orig")/before_restore_$(date +%Y%m%d-%H%M%S)"
        if ! { mkdir -p "$bk" && cp -a "$LEASES_FILE" "$bk/"; } 2>>"$out"; then  # never overwrite leases without a copy of them
          res=failed; txt="copy of the current leases FAILED (disk full?) - nothing restored"
        elif ! cp -a "$orig/dhcpd.leases" "$LEASES_FILE" 2>>"$out"; then  # half-written file: put the current leases back
          cp -a "$bk/$(basename "$LEASES_FILE")" "$LEASES_FILE" 2>>"$out"
          res=failed; txt="writing the original leases FAILED - current leases kept"
        fi
        rm -f "$STATE_DIR/admin_stopped"; svc start >>"$out" 2>&1; sleep "$START_WAIT"
        if [ "$res" = ok ] && [ "$(dhcpd_running)" = 1 ]; then txt="original leases restored ($(lease_ips "$LEASES_FILE") IP), dhcpd running (pid $(pid_now)); leases before the restore in $bk"
        elif [ "$res" = ok ]; then res=failed; txt="dhcpd did not start after the restore - leases before the restore in $bk"
        else txt="$txt; dhcpd $([ "$(dhcpd_running)" = 1 ] && echo running || echo NOT running)"; fi
        prune_own "$(dirname "$orig")" before_restore_
      fi ;;
    delfirst)  # delete the ORIGINAL backups (leases copy of the first run + CFG backup start_*) once the NetBox CFG runs; only own dirs below /opt
      local orig b n=0 gone=""
      orig=$(state first_leases | cut -d'|' -f4)
      if [ -z "$(state running)" ] || [ "$(dhcpd_running)" != 1 ]; then
        res=failed; txt="refused: the NetBox CFG must be deployed and dhcpd running"
      else
        if [ -n "$orig" ] && [[ "${orig##*/}" =~ ^original_[0-9]{8}-[0-9]{6}$ ]] && backup_ok "$(dirname "$orig")" && [ -d "$orig" ] && [ ! -L "$orig" ]; then
          rm -rf -- "$orig" && { n=$((n + 1)); gone="$gone $orig"; }
        fi
        for b in $(first_cfg_info | tr ',' '\n' | cut -d'|' -f1); do
          backup_ok "$(dirname "$b")" && [[ "${b##*/}" =~ ^start_[0-9]{8}-[0-9]{6}$ ]] && [ -d "$b" ] && [ ! -L "$b" ] && rm -rf -- "$b" && { n=$((n + 1)); gone="$gone $b"; }
        done
        echo "deleted|$(date +%s)" >"$STATE_DIR/first_leases"  # never copy the "original" leases again (they are NetBox leases now)
        txt="original backups deleted ($n):${gone:- nothing found}"
      fi ;;
    simfirst)  # TEST server only: forget the agent state (never the files) -> the next contact is a first installation
      if [ "$TEST_SERVER" = no ] || { [ "$TEST_SERVER" != yes ] && [ -z "$NB_TEST" ]; }; then
        res=failed; txt="refused: not a test server (TEST_SERVER=$TEST_SERVER in $CONF_FILE, NetBox test server: ${NB_TEST:-no})"; log "SECURITY: first run simulation refused - not a test server"
      else
        local k; for k in running label first_leases check leases_event applied; do rm -f "$STATE_DIR/$k"; done
        txt="agent state cleared (files kept) - the next contact runs as a first installation"
      fi ;;
    *) res=failed; txt="unknown command $CMD" ;;
  esac
  echo "$CMD_ID:$res:$txt" >"$STATE_DIR/cmd_done"
  echo "$CMD $(date '+%F %T') $res" >"$STATE_DIR/last_cmd"
  log "NetBox command '$CMD': $res - $txt"
  [ "$res" = ok ] || [ "$CMD" = update ] || diag "$out"
}

ensure_up() {  # keep dhcpd up after Start/Restart: test CFG, kill a stray dhcpd, remove a stale pidfile, start; retry ~1/min until it runs (NOT a CFG error)
  [ -e "$STATE_DIR/want_up" ] || return 0
  [ "$(state admin_stopped)" = 1 ] && { rm -f "$STATE_DIR/want_up"; return 0; }
  if [ "$(dhcpd_running)" = 1 ] && [ ! -e "$STATE_DIR/force_restart" ]; then  # dhcpd serves (maybe started by hand / by the service): done, NetBox gets OK
    rm -f "$STATE_DIR/want_up"; OUT="$WORK/up"; : >"$OUT"
    echo "dhcpd is running (pid $(pid_now))" >>"$OUT"; echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"
    log "dhcpd is running (pid $(pid_now)) - retry finished"; report ok "$OUT"; return 0
  fi
  local now last; now=$(date +%s); last=$(state want_up_ts)
  [ -n "$last" ] && [ $((now - last)) -lt 55 ] && return 0  # at most once per minute
  echo "$now" >"$STATE_DIR/want_up_ts"; rm -f "$STATE_DIR/force_restart"
  OUT="$WORK/up"; : >"$OUT"
  local cmd rc p0
  cmd="${TEST_CMD:-${ALLOWED_TEST_CMDS[0]}}"; cmd=$(allowed "$cmd" "${ALLOWED_TEST_CMDS[@]}")
  echo "\$ $cmd" >>"$OUT"; bash -c "$cmd" >>"$OUT" 2>&1; rc=$?
  if [ $rc -ne 0 ]; then  # the on-disk CFG is bad -> this really is a CFG problem, stop retrying
    rm -f "$STATE_DIR/want_up"
    log "retry: dhcpd -t FAILED - this is a CFG problem, stopping retries"
    report test_failed "$OUT"; return 0
  fi
  log "retry: CFG tests OK, (re)starting dhcpd"
  p0=$(pid_now); kill_stray "$OUT"
  cmd="${RESTART_CMD:-${ALLOWED_RESTART_CMDS[0]}}"; cmd=$(allowed "$cmd" "${ALLOWED_RESTART_CMDS[@]}")
  echo "\$ $cmd" >>"$OUT"; mark_agent; bash -c "$cmd" >>"$OUT" 2>&1; sleep "$START_WAIT"; pid_step "retry start" "$p0"
  if [ "$(dhcpd_running)" = 1 ]; then
    rm -f "$STATE_DIR/want_up"; echo "$HASH" >"$STATE_DIR/running"; echo "$CFG" >"$STATE_DIR/label"
    log "dhcpd is UP (pid $(pid_now)) after retry"; report ok "$OUT"
  else
    log "dhcpd still not up (NOT a CFG problem) - will try again in ~1 min"
    diag "$OUT"; report start_failed "$OUT"
  fi
}

heal() {  # (a) manual restart asked in NetBox -> continuous retry; (b) disk = current CFG but dhcpd down -> one automatic attempt per CFG
  [ "$(isc_version)" != none ] || return 0
  [ "$(state admin_stopped)" = 1 ] && return 0  # stopped from NetBox: stays down until Start / Restart / a new CFG
  if [ -n "$RESTART_REQ" ] && [ "$RESTART_REQ" != "$(state restart_req)" ]; then
    echo "$RESTART_REQ" >"$STATE_DIR/restart_req"; log "manual restart asked in NetBox"
    echo 1 >"$STATE_DIR/want_up"; echo 1 >"$STATE_DIR/force_restart"; rm -f "$STATE_DIR/want_up_ts"; return 0  # ensure_up does a real restart, and keeps retrying
  fi
  [ -e "$STATE_DIR/want_up" ] && return 0  # continuous retry already armed (ensure_up handles it)
  # disk = current CFG but dhcpd is down (crash, failed service, after an agent update) -> arm continuous retry automatically
  if [ "$DISK" = current ] && [ "$(dhcpd_running)" != 1 ]; then
    echo 1 >"$STATE_DIR/want_up"; rm -f "$STATE_DIR/want_up_ts"
    log "dhcpd is down and the disk already has the current CFG - will keep (re)starting it until it is up"
  fi
}

disk_files() {  # sha256sum of every CFG file on disk: dhcpd.conf + the managed dirs (editor files .* and *~ left out)
  local f d
  f=$(state conf); [ -n "$f" ] || f="$DHCP_CONF_DIR/dhcpd.conf"  # first contact: the fixed conf dir (an original dhcpd.conf must be seen)
  [ -f "$f" ] && sha256sum "$f"
  while read -r d; do [ -d "$d" ] && find "$d" -maxdepth 1 -type f ! -name '*.isc-new' ! -name '.*' ! -name '*~' -exec sha256sum {} +; done < <(state dirs)
}

hash_of() {  # ONE control hash from sha256sum lines ("path sha" lines, byte order) = the same as NetBox's check hash
  sed -nE 's/^([0-9a-f]{64}) [ *](.*)$/\2 \1/p' "$1" | LC_ALL=C sort | sha256sum | cut -d' ' -f1
}

contact() {
  local have="$WORK/have" resp="$WORK/resp" code
  first_leases  # first run: a copy of the original leases (kept, never pruned)
  leases_tick  # periodic copy of the lease database (settings from NetBox, stored at the last contact) - before the request, so NetBox gets the current time
  disk_files >"$have" 2>/dev/null
  DISK_HASH=$(hash_of "$have"); APPLIED=""
  local send="$have" nofiles=""
  if [ -n "$(state check)" ] && [ "$(state check)" = "$DISK_HASH" ]; then send="$WORK/none"; : >"$send"; nofiles=1; fi  # equal: hash only, no file list
  local url alt
  DUP_FIXED=""; dedupe_dhcpd
  reboot_check; [ -z "$REBOOT_STOP" ] && test_keep_off  # test server stopped from NetBox: never left running
  FIX_NOW="${FIXED:-}"; FIXED=""  # server settings the agent fixed (sent once)
  EVENT=$(dhcpd_event); EVENT_NOW=$(dhcpd_running); PID_NOW=$(pid_now); WHY=""; LOG_EVENT=""
  case "$EVENT" in manual_stop) WHY=$(why_changed stop) ;; manual_start) WHY=$(why_changed start) ;; manual_restart) WHY=$(why_changed restart) ;; esac
  FRESH=""; INCLUDES=""
  if [ -z "$(state running)" ]; then  # never deployed a NetBox CFG: NetBox checks whether an original DHCP runs here (asks the admin first)
    FRESH=1
    [ -f "$DHCP_CONF_DIR/dhcpd.conf" ] && INCLUDES=$(sed -nE 's/^[[:space:]]*include[[:space:]]+"([^"]+)".*/\1/p' "$DHCP_CONF_DIR/dhcpd.conf" 2>/dev/null | head -30 | tr '\n' ',')
  fi
  LOG_WHY="$WHY"; LEASES_EV=$(state leases_event); APPLIED_EV=$(state applied | tr '\n' ',')
  local urls=(); mapfile -t urls < <(netbox_urls)
  [ ${#urls[@]} -gt 0 ] || urls=("$NETBOX_URL")
  local try
  for try in 1 2; do
  for url in "${urls[@]}"; do
    code=$(curl -sS "${CURL_OPTS[@]}" "${AUTH[@]}" --connect-timeout 10 --max-time 60 -o "$resp" -w '%{http_code} %{redirect_url}' -X POST "${url}?format=text" \
      --data-urlencode "files@$send" --data-urlencode "nofiles=$nofiles" --data-urlencode "disk_hash=$DISK_HASH" --data-urlencode "agent=$AGENT_VERSION" --data-urlencode "isc=$(isc_version)" \
      --data-urlencode "dhcpd=$(dhcpd_running)" --data-urlencode "running=$(state running)" \
      --data-urlencode "dhcpd_event=$EVENT" --data-urlencode "dhcpd_why=$WHY" --data-urlencode "dhcpd_pid=$(pid_now)" --data-urlencode "leases_last=$(state leases_ts)" --data-urlencode "leases_sha=$(state leases_sum)" --data-urlencode "leases_copy=$LEASES_EV" --data-urlencode "applied=$APPLIED_EV" --data-urlencode "fresh=$FRESH" --data-urlencode "disk_usage=$(disk_usage)" --data-urlencode "first_leases=$(state first_leases)" --data-urlencode "first_cfg=$(first_cfg_info)" --data-urlencode "includes=$INCLUDES" --data-urlencode "svc=$(svc_state)" --data-urlencode "dup=$DUP_FIXED" --data-urlencode "fix=$FIX_NOW" --data-urlencode "svc_why=$(svc_why)" --data-urlencode "cmd_done=$(state cmd_done)" --data-urlencode "insecure=$(case "$url" in http://*) echo 1 ;; esac)" 2>"$WORK/curlerr") && break
    log "NetBox not reachable at $url: $(cat "$WORK/curlerr")"
    code=000
  done
  [ "$code" = 000 ] && return 1
  local ck; ck=$(sed -n 's/^check\t\([0-9a-f]\{64\}\)$/\1/p' "$resp" | head -1)
  [ -n "$ck" ] && echo "$ck" >"$STATE_DIR/check"
  # hash only, but NetBox's CFG changed meanwhile: ask again at once with the file list (NetBox needs it for the plan)
  if [ -n "$nofiles" ] && [ -n "$ck" ] && [ "$ck" != "$DISK_HASH" ]; then  # NetBox already got the event / fix / dup of this contact: never twice
    send="$have"; nofiles=""; LOG_EVENT="$EVENT"; EVENT=""; WHY=""; DUP_FIXED=""; FIX_NOW=""; LEASES_EV=""; continue
  fi
  break
  done
  local redir="${code#* }"; code="${code%% *}"
  if [ "$url" != "$NETBOX_URL" ]; then NETBOX_URL="$url"; save_url "$url"; fi
  DL_PATH=(); DL_SHA=(); DL_URL=(); BACKUP_PATHS=(); DELETES=(); DIRS=()
  NB_TEST=""; TEST_CMD=""; RESTART_CMD=""; REPORT_URL=""; BACKUP_TO=""; HASH=""; CFG=""; WAIT=""; ERR=""; CONF_DIR=""; BASE=""; NEWKEY=""; ON_FAIL="restore"; BUNDLE=""; DISK=""; RESTART_REQ=""; CMD=""; CMD_ID=""; AGENT_URL=""; AGENT_SHA=""
  local key a b c
  while IFS=$'\t' read -r key a b c; do
    [ -n "$key" ] || continue
    if [ "$key" = cmd ]; then is_command "cmd $a"; else is_command "$key"; fi || {
      log "SECURITY: command from NetBox is not in AGENT_COMMANDS - ignored: $(printf '%s %s' "$key" "$a" | tr -cd 'A-Za-z0-9_ -' | cut -c1-60)"; continue; }
    case "$key" in
      interval) [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -ge 10 ] && [ "$a" -le 1800 ] && { [ "$a" != "$(state interval)" ] && { echo "$a" >"$STATE_DIR/interval"; applied_add interval; log "setting from NetBox: contact interval $a s"; }; INTERVAL="$a"; } ;;
      key) NEWKEY="$a" ;;
      report) REPORT_URL=$(rebase "$a") ;;
      on_test_fail) case "$a" in restore|keep) ON_FAIL="$a" ;; esac ;;
      bundle) BUNDLE=$(rebase "$a") ;;
      disk) DISK="$a" ;;
      restart_req) RESTART_REQ="$a" ;;
      cmd) [[ "$b" =~ ^[A-Za-z0-9_-]{1,40}$ ]] && { CMD="$a"; CMD_ID="$b"; } ;;
      agent_url) AGENT_URL=$(rebase "$a") ;;
      agent_sha) AGENT_SHA="$a" ;;
      leases) if [[ "$a" =~ ^[0-9]{1,5}$ ]] && [[ "$b" =~ ^[0-9]{1,4}$ ]] && [ "$b" -ge 1 ] && backup_ok "$c"; then
                [ "$(state leases_cfg)" = "$a|$b|$c" ] || { echo "$a|$b|$c" >"$STATE_DIR/leases_cfg"
                  applied_add leases; log "setting from NetBox: lease copy every $([ "$a" = 0 ] && echo "- (off)" || echo "$a min"), keep $b copies, directory $c"; }
              else log "SECURITY: lease copy settings from NetBox refused (directory only below /opt): $(printf '%s' "$c" | tr -cd 'A-Za-z0-9_./-' | cut -c1-80)"; fi ;;
      time_format) case "$a" in eu|iso|compact) [ "$(state time_fmt)" = "$a" ] || { echo "$a" >"$STATE_DIR/time_fmt"; applied_add time_format; log "setting from NetBox: date format of lease copy dirs $a ($(date +"$(fmt_date)"))"; } ;; esac ;;
      test_server) [ "$a" = 1 ] && NB_TEST=1 ;;  # NetBox: this server is marked as test server
      check) ;;  # ONE control hash of NetBox's CFG, stored above (next contact sends the file list only when the disk differs)
      hash) [[ "$a" =~ ^[0-9a-f]{64}$ ]] && HASH="$a" ;; cfg) [[ "$a" =~ ^[0-9]{2}\.[0-9]{2}\.[0-9]{2}_[0-9]{1,6}$ ]] && CFG="$a" ;; wait) WAIT="$a" ;; error) ERR="$a" ;;
      conf_dir) CONF_DIR="$a" ;; base) BASE="$a" ;; dir) DIRS+=("$a") ;;
      backup) BACKUP_TO="$a"; IFS=$'\t' read -r -a BACKUP_PATHS <<<"$b${c:+	$c}" ;;
      download) DL_PATH+=("$a"); DL_SHA+=("$b"); DL_URL+=("$(rebase "$c")") ;;
      test) TEST_CMD="$a" ;; restart) RESTART_CMD="$a" ;; delete) DELETES+=("$a") ;;
    esac
  done < <([ "$code" = 200 ] && cat "$resp")  # only a real NetBox answer is a plan (a proxy error page is not)
  if [ "$code" = 200 ]; then  # NetBox's switch "Test server", kept for the next boot
    if [ -n "$NB_TEST" ]; then [ "$(state is_test)" = 1 ] || echo 1 >"$STATE_DIR/is_test"; else rm -f "$STATE_DIR/is_test"; fi
  fi
  [ "$code" = 200 ] && event_sent
  if [ "$code" != 200 ]; then
    case "$code" in
      403) log "NetBox answered 403: this server's IP is not in CFG pluginu -> DHCP servery, the server is switched off, or NETBOX_TOKEN is missing/wrong (see Audit -> Agent)" ;;
      301|302|307|308) log "NetBox answered $code (redirect to $redir): login page = use the agent API address (/api/plugins/isc-dhcp/agent/) + NETBOX_TOKEN, https = use the https URL" ;;
      000) log "NetBox not reachable (DNS, firewall or TLS certificate - see CURL_OPTS)" ;;
      *) log "NetBox answered $code ${ERR}" ;;
    esac
    return 1
  fi
  check_paths
  if [ "${NETBOX_URL#http://}" != "$NETBOX_URL" ] && [ $(( $(date +%s) - $(state https_probe || echo 0) )) -ge 3600 ]; then
    date +%s >"$STATE_DIR/https_probe"  # plain http: try https once an hour, switch when it works (never the other way)
    local hs
    for hs in $(netbox_urls | grep '^https://'); do
      if [ "$(curl -sS "${CURL_OPTS[@]}" "${AUTH[@]}" --connect-timeout 5 --max-time 20 -o /dev/null -w '%{http_code}' "${hs}?format=text" 2>/dev/null)" = 200 ]; then
        NETBOX_URL="$hs"; save_url "$hs"; log "https works now - switched to $hs (key and CFG encrypted)"; break
      fi
    done
  fi
  if [ -n "$NEWKEY" ] && ! [[ "$NEWKEY" =~ ^[A-Za-z0-9._-]{16,128}$ ]]; then log "SECURITY: key from NetBox has an invalid format - ignored"; NEWKEY=""; fi
  if [ -n "$NEWKEY" ] && [ "$NEWKEY" != "$NETBOX_TOKEN" ]; then  # key change in NetBox: test the new key, then keep it
    local tc
    local nh=(-H "Authorization: Token $NEWKEY")
    curl_hdr_file_ok && hdr_file "$WORK/newkey.hdr" "$NEWKEY" && nh=(-H "@$WORK/newkey.hdr")
    tc=$(curl -sS "${CURL_OPTS[@]}" "${nh[@]}" --max-time 60 -o /dev/null -w '%{http_code}' "${NETBOX_URL}?format=text" 2>/dev/null)
    if [ "$tc" = 200 ]; then
      conf_set_quiet NETBOX_TOKEN "$NEWKEY" && NETBOX_TOKEN="$NEWKEY" && set_auth
      log "new API key received from NetBox, tested OK and saved"
    else
      log "new API key from NetBox did not work (HTTP $tc) - keeping the old one"
    fi
  fi
  OUT="$WORK/aa"; apparmor_fix  # AppArmor is watched on every contact
  [ "$(isc_version)" != none ] && default_fix  # /etc/default/isc-dhcp-server is watched on every contact
  [ ${#DIRS[@]} -gt 0 ] && printf '%s\n' "${DIRS[@]}" >"$STATE_DIR/dirs"
  for f in "${DL_PATH[@]}"; do [ "$(dirname "$f")" = "$CONF_DIR" ] && echo "$f" >"$STATE_DIR/conf"; done
  [ -z "$(state conf)" ] && [ -n "$CONF_DIR" ] && echo "$CONF_DIR/dhcpd.conf" >"$STATE_DIR/conf"
  run_cmd  # Start / Stop / Restart / Update from NetBox
  heal  # manual restart / self-heal
  ensure_up  # keep retrying dhcpd start every ~minute after Start/Restart until it is up
  local dk; dk="$(dhcpd_running)|$(svc_state)|$(pid_now)"
  if [ "$dk" != "$(state diag_key)" ]; then
    echo "$dk" >"$STATE_DIR/diag_key"
    [ "$(isc_version)" != none ] && { [ "$(dhcpd_running)" != 1 ] || ! svc_is_active; } && diag "$WORK/diag"
  fi
  if [ -n "$WAIT" ]; then  # log only when the reason changes (no line every interval)
    [ "$WAIT $CFG" != "${LAST_WAIT:-}" ] && log "waiting ($WAIT) CFG $CFG"
    LAST_WAIT="$WAIT $CFG"; return 0
  fi
  LAST_WAIT=""
  if [ ${#DL_PATH[@]} -eq 0 ] && [ ${#DELETES[@]} -eq 0 ]; then return 0; fi
  [ "$(isc_version)" = none ] && { log "ISC dhcpd is not installed - plan ignored"; return 0; }
  if [ -n "$BASE_REFUSED" ]; then OUT="$WORK/refused"; echo "SECURITY: $BASE_REFUSED" >"$OUT"; report failed "$OUT"; return 0; fi
  log "CFG $CFG: ${#DL_PATH[@]} to download, ${#DELETES[@]} to delete"
  apply
}

fmt_date() {  # date format of the lease copy dirs (set in NetBox): eu DD.MM.YYYY-HH:MM | iso YYYY-MM-DD_HH:MM | compact YYYYmmdd-HHMMSS
  case "$(state time_fmt)" in iso) echo '%Y-%m-%d_%H:%M' ;; compact) echo '%Y%m%d-%H%M%S' ;; *) echo '%d.%m.%Y-%H:%M' ;; esac
}

copy_key() {  # name of an own lease copy (any of the 3 formats, or the old file dhcpd.leases_<compact>) -> YYYYmmddHHMMSS, "" = not ours
  local n="$1"
  if [[ "$n" =~ ^([0-9]{2})\.([0-9]{2})\.([0-9]{4})-([0-9]{2})[:.]([0-9]{2})$ ]]; then echo "${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}${BASH_REMATCH[4]}${BASH_REMATCH[5]}00"
  elif [[ "$n" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})_([0-9]{2})[:.]([0-9]{2})$ ]]; then echo "${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}${BASH_REMATCH[5]}00"
  elif [[ "$n" =~ ^(dhcpd\.leases_)?([0-9]{8})-([0-9]{6})$ ]]; then echo "${BASH_REMATCH[2]}${BASH_REMATCH[3]}"
  fi
}

key_name() {  # YYYYmmddHHMMSS -> dir name in the current format
  local k="$1"
  date -d "${k:0:4}-${k:4:2}-${k:6:2} ${k:8:2}:${k:10:2}:${k:12:2}" +"$(fmt_date)" 2>/dev/null
}

leases_rename() {  # the format changed in NetBox (or old flat copies exist): rename / move ONLY own copies to <dir>/<date-time>/dhcpd.leases
  local d="$1" e n k t moved=0
  [ "$(state leases_fmt_done)" = "$(state time_fmt)|$d" ] && return 0
  for e in "$d"/*; do
    [ -e "$e" ] && [ ! -L "$e" ] || continue
    n="${e##*/}"; k=$(copy_key "$n"); [ -n "$k" ] || continue
    t=$(key_name "$k"); [ -n "$t" ] || continue
    if [ -f "$e" ]; then  # old copy file dhcpd.leases_<time> -> own dir with the original name
      [ -e "$d/$t" ] || { mkdir -p "$d/$t" && mv -f -- "$e" "$d/$t/dhcpd.leases" && moved=$((moved + 1)); }
    elif [ -d "$e" ] && [ "$n" != "$t" ] && [ ! -e "$d/$t" ]; then
      mv -- "$e" "$d/$t" && moved=$((moved + 1))
    fi
  done
  [ "$moved" -gt 0 ] && log "lease copies: $moved renamed to the date format $(fmt_date) (set in NetBox)"
  echo "$(state time_fmt)|$d" >"$STATE_DIR/leases_fmt_done"
}

leases_tick() {  # copy the lease database every N minutes to <backup dir>/leases/<date-time>/ (only below /opt), keep the newest K
  local cfg ev kp dir now last sum name
  cfg=$(state leases_cfg); [ -n "$cfg" ] || return 0
  IFS='|' read -r ev kp dir <<<"$cfg"
  backup_ok "$dir" || return 0
  [ -d "$dir" ] && leases_rename "$dir"
  [[ "$ev" =~ ^[0-9]+$ ]] && [ "$ev" -gt 0 ] || return 0
  now=$(date +%s); last=$(state leases_ts); [[ "$last" =~ ^[0-9]+$ ]] || last=0
  [ $((now - last)) -ge $((ev * 60)) ] || return 0
  [ -f "$LEASES_FILE" ] && [ ! -L "$LEASES_FILE" ] || return 0
  mkdir -p "$dir" || return 0
  sum=$(sha256sum "$LEASES_FILE" | cut -d' ' -f1)
  if [ "$sum" != "$(state leases_sum)" ] || [ "$(prune_list "$dir" | wc -l)" -eq 0 ]; then  # unchanged = the newest copy is still current
    name="$dir/$(date +"$(fmt_date)")"
    if [ -e "$name" ]; then :  # a copy from this very minute exists
    elif mkdir "$name.part" && copy_leases_to "$name.part" && mv -- "$name.part" "$name"; then
      echo "${name##*/}|$(state leases_sum)|$sum" >"$STATE_DIR/leases_event"  # reported once to NetBox (Audit INFO)
      echo "$sum" >"$STATE_DIR/leases_sum"; log "lease database copied -> $name/ (sha256 ${sum:0:12})"
    else
      case "$name.part" in "$dir"/*.part) rm -rf -- "$name.part" ;; esac
      log "lease database copy FAILED -> $name"; return 0
    fi
  fi
  prune_leases "$dir" "$kp"  # also after the count was lowered in NetBox
  echo "$now" >"$STATE_DIR/leases_ts"
}

copy_leases_to() {  # dhcpd.leases (+ dhcpd.leases~) with the original names into $1
  local lf
  for lf in "$LEASES_FILE" "$LEASES_FILE~"; do
    [ -f "$lf" ] && [ ! -L "$lf" ] || continue
    cp -a -- "$lf" "$1/" || return 1
  done
}

prune_list() {  # own copies in the leases dir, newest first ("<key> <name>")
  local e n k
  for e in "$1"/*; do
    [ -e "$e" ] && [ ! -L "$e" ] || continue
    n="${e##*/}"; k=$(copy_key "$n"); [ -n "$k" ] && echo "$k $n"
  done | sort -r
}

prune_leases() {  # rm ONLY its own copies (<date-time> dirs, old dhcpd.leases_<time> files) in the leases dir below /opt, newest $2 kept
  local d="$1" k="$2" n
  backup_ok "$d" && [[ "$k" =~ ^[0-9]+$ ]] && [ "$k" -ge 1 ] || return 0
  prune_list "$d" | tail -n +"$((k + 1))" | while read -r _ n; do
    [ -n "$n" ] && [ -e "$d/$n" ] && [ ! -L "$d/$n" ] && rm -rf -- "${d:?}/$n"
  done
}

watch_wait() {  # sleep INTERVAL, but every 5 s look at dhcpd (PID, running) and the control hash of the CFG files: a change outside the agent = contact NetBox now
  local seen now t=0 base cur tmp="$STATE_DIR/watch.sha"
  seen="$(dhcpd_running)|$(pid_now)"
  base="${DISK_HASH:-}"  # the hash NetBox got: a file written while the agent was hashing is never missed
  [ -n "${APPLIED:-}" ] || [ -z "$base" ] && { disk_files >"$tmp" 2>/dev/null; base=$(hash_of "$tmp"); }  # the agent itself changed the files
  while [ "$t" -lt "$INTERVAL" ]; do
    sleep 5; t=$((t + 5))
    [ -e "$STATE_DIR/want_up" ] && [ "$t" -ge 60 ] && return 0  # dhcpd should be up: retry every ~minute, not only every interval
    leases_tick
    now="$(dhcpd_running)|$(pid_now)"
    if [ "$now" != "$seen" ]; then log "dhcpd changed outside the agent (running|pid ${seen} -> ${now}) - checking CFG hash and contacting NetBox now"; return 0; fi
    disk_files >"$tmp" 2>/dev/null; cur=$(hash_of "$tmp")
    if [ "$cur" != "$base" ]; then log "CFG files changed outside the agent (control hash ${base:0:12} -> ${cur:0:12}) - contacting NetBox now"; return 0; fi
  done
}

INTERVAL=60
[ "$(state agent_ver)" = "$AGENT_VERSION" ] || { dhcpd_running >"$STATE_DIR/dhcpd_prev"; echo "$AGENT_VERSION" >"$STATE_DIR/agent_ver"; }
case "$NETBOX_URL" in http://*) log "SECURITY WARNING: NetBox address is plain http - the key and the CFG travel unencrypted (use https)" ;; esac
log "isc-dhcp-agent $AGENT_VERSION started, NetBox $NETBOX_URL, ISC $(isc_version), dhcpd $([ "$(dhcpd_running)" = 1 ] && echo "running (pid $(pid_now))" || echo NOT running), service $(svc_state)"
while true; do
  WORK=$(mktemp -d /tmp/isc-dhcp-agent.XXXXXXXX) || die "mktemp failed"
  contact
  case "$WORK" in /tmp/isc-dhcp-agent.????????) rm -rf -- "$WORK" ;; esac  # only its own temp dir
  [ "$ONCE" = 1 ] && break
  watch_wait
done
